---
import { useState } from "react";
import Neon from "./NeonText.astro";
import "@fontsource/neonderthaw";
import "@fontsource-variable/inconsolata";
---

<div class="coming-soon-container">
  <div class="content">
    <Neon text="Super Jackfruit Labs" />
  </div>
</div>

<style>
  /* Basic Reset */
  .coming-soon-container {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    background: radial-gradient(ellipse at center, #4c054d 0%, #0c100d 100%), url('/brick-pattern.jpg');
    background-size: cover;
    background-blend-mode: multiply;
  }

  .content {
    text-align: center;
    color: #fff;
    padding: 20px;
  }
</style>
