---
import { useState } from "react";
import Neon from "./NeonText.astro";
import TerminalText from "./TerminalText.astro";
import TerminalInput from "./TerminalInput.astro";
import NewTerminalInput from "./NewTerminalInput.astro";

let email = "";
let emailExists = false;
let submitted = false;
const existingEmails = ["test@example.com", "user@example.com"];

const handleSubmit = (event: Event) => {
  event.preventDefault();

  if (existingEmails.includes(email)) {
    emailExists = true;
  } else {
    submitted = true;
    emailExists = false;
    // Add the email to your backend or mailing list here
  }
};
---

<div class="coming-soon-container">
  <!-- <div class="overlay"></div> -->
  <div class="content">
    <Neon text="Super Jackfruit Labs" />
    <!-- <NewTerminalInput /> -->
