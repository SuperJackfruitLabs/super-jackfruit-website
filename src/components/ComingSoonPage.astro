---
import Neon from "./NeonText.astro";
import CLISignup from "./CLISignup.astro";
---

<div class="coming-soon-container">
  <div class="content">
    <div class="neon-wrapper">
      <Neon text="Super Jackfruit Labs" />
    </div>
    <div class="cli-wrapper">
      <CLISignup />
    </div>
  </div>
</div>

<style>
  /* Basic Reset */
  .coming-soon-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    background-size: cover;
    background-blend-mode: multiply;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 800px; /* Adjust as needed */
    padding: 20px;
  }

  .neon-wrapper {
    margin-bottom: 6rem; /* Increase this value to add more space */
  }

  .cli-wrapper {
    width: 100%;
  }
</style>
