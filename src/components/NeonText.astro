---
import '@fontsource/tilt-neon'

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<!--
  Two stacked copies: a glowless base and a full-glow twin. The flicker
  animates the twin's OPACITY only — compositor work, zero paint — instead
  of animating multi-layer text/box shadows, which forced an expensive
  re-rasterization of the whole sign on every flicker snap.
-->
<div class="neon-sign" id="neon-sign">
  <h1 id="neon-text" class="neon-base" spellcheck="false">{text}</h1>
  <h1 class="neon-glow" aria-hidden="true">{text}</h1>
</div>

<style>
  :root {
    font-size: 10px;
    --neon-text-color: var(--initialTextColor);
    --neon-border-color: var(--initialBorderColor);
  }

  .neon-sign {
    position: relative;
    display: inline-block;
    visibility: hidden;
  }

  .neon-sign h1 {
    font-family: "Tilt Neon", system-ui;
    font-size: 8rem;
    font-weight: 400;
    color: #fff;
    margin: 0;
    padding: 4rem 6rem 5.5rem;
    border: 0.4rem solid #fff;
    border-radius: 2rem;
    user-select: none;
  }

  /* the "tube off" state: plain text and border, painted once */
  .neon-base {
    text-shadow: none;
  }

  /* the "tube on" state: all the glow, on its own GPU-cached layer */
  .neon-glow {
    position: absolute;
    inset: 0;
    text-shadow:
      0 0 4px #fff,
      0 0 11px #fff,
      0 0 19px #fff,
      0 0 40px var(--neon-text-color),
      0 0 80px var(--neon-text-color),
      0 0 90px var(--neon-text-color),
      0 0 100px var(--neon-text-color),
      0 0 150px var(--neon-text-color);
    box-shadow:
      0 0 .5rem #fff,
      inset 0 0 .5rem #fff,
      0 0 2rem var(--neon-border-color),
      inset 0 0 2rem var(--neon-border-color),
      0 0 4rem var(--neon-border-color),
      inset 0 0 4rem var(--neon-border-color);
    animation: glow-flicker 1.5s infinite alternate;
    will-change: opacity;
    transform: translateZ(0);
    transition: text-shadow 0.2s, box-shadow 0.2s;
  }

  /* same timing as the original shadow-keyframe flicker, expressed as opacity */
  @keyframes glow-flicker {
    0%, 18%, 22%, 25%, 53%, 57%, 100% { opacity: 1; }
    20%, 24%, 55% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .neon-glow {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .neon-sign h1 {
      font-size: 6rem;
      padding: 2rem 3rem 2.75rem;
      border-width: 0.3rem;
    }
  }
</style>

<script>
  const soothing_colors = [
    '#0fe513', '#09e6f2', '#f2a707', '#5834f9', '#a12cf9',
    '#fc5553', '#ef7381', '#5c18f2', '#bfee21', '#ad2624'
  ];

  function getRandomColor() {
    return soothing_colors[Math.floor(Math.random() * soothing_colors.length)];
  }

  function getContrastingColor(color: string) {
    const index = soothing_colors.indexOf(color);
    const oppositeIndex = (index + Math.floor(soothing_colors.length / 2)) % soothing_colors.length;
    return soothing_colors[oppositeIndex];
  }

  function updateColors() {
    const root = document.documentElement;
    const newTextColor = getRandomColor();
    const newBorderColor = getContrastingColor(newTextColor);

    root.style.setProperty('--neon-text-color', newTextColor);
    root.style.setProperty('--neon-border-color', newBorderColor);
  }

  updateColors();

  // Add event listener for spacebar
  document.addEventListener('keydown', (event) => {
    if (event.code === 'Space') {
      event.preventDefault(); // Prevent scrolling
      updateColors();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const neonText = document.getElementById('neon-text');
    if (neonText) {
      neonText.addEventListener('touchstart', updateColors);
    }
  });

  // Clean up function to remove event listener and clear interval
  document.addEventListener('astro:page-load', () => {
    document.removeEventListener('keydown', updateColors);
    document.removeEventListener('touchstart', updateColors);
  });

  document.fonts.ready.then(() => {
    const sign = document.getElementById('neon-sign');
    if (sign) {
      sign.style.visibility = 'visible';
    }
  });
</script>
