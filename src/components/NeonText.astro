---
import '@fontsource/neonderthaw'
import '@fontsource/tilt-neon'

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<h1 id="neon-text" spellcheck="false">{text}</h1>

<style>
  /* @import url(https://fonts.googleapis.com/css2?family=Neonderthaw&display=swap); */

  :root {
    font-size: 10px;
    --neon-text-color: var(--initialTextColor);
    --neon-border-color: var(--initialBorderColor);
  }

  @keyframes flicker {
  0%, 18%, 22%, 25%, 53%, 57%, 100% {
    text-shadow:
      0 0 4px #fff,
      0 0 11px #fff,
      0 0 19px #fff,
      0 0 40px var(--neon-text-color),
      0 0 80px var(--neon-text-color),
      0 0 90px var(--neon-text-color),
      0 0 100px var(--neon-text-color),
      0 0 150px var(--neon-text-color);
    box-shadow:
      0 0 .5rem #fff,
      inset 0 0 .5rem #fff,
      0 0 2rem var(--neon-border-color),
      inset 0 0 2rem var(--neon-border-color),
      0 0 4rem var(--neon-border-color),
      inset 0 0 4rem var(--neon-border-color);
  }
  20%, 24%, 55% {
    text-shadow: none;
    box-shadow: none;
  }
}

h1 {
    font-family: "Tilt Neon", system-ui;
    font-size: clamp(2rem, 5vw + 1rem, 5rem); /* Fluid typography */
    font-weight: 400;
    color: #fff;
    padding: clamp(1rem, 3vw, 3rem) clamp(1.5rem, 4vw, 4.5rem);
    border: clamp(0.1rem, 0.3vw, 0.25rem) solid #fff;
    border-radius: clamp(0.5rem, 1vw, 1.5rem);
    animation: flicker 1.5s infinite alternate;
    user-select: none;
    transition: text-shadow 0.2s, box-shadow 0.2s;
    text-shadow: 0 0 4px #fff, 0 0 11px #fff, 0 0 19px #fff;
    visibility: hidden;
    max-width: 90vw; /* Prevent text from overflowing on small screens */
    margin: 0 auto; /* Center the text */
    word-break: break-word; /* Allow long words to break */
  }

/* @media (max-width: 640px) {
  h1 {
    font-size: 3rem;
    padding: 2rem 3rem 2.5rem;
    border-width: 0.3rem;
  }
} */
</style>

<script>
  const soothing_colors = [
    '#0fe513', '#09e6f2', '#f2a707', '#5834f9', '#a12cf9',
    '#fc5553', '#ef7381', '#5c18f2', '#bfee21', '#ad2624'
  ];

  function getRandomColor() {
    return soothing_colors[Math.floor(Math.random() * soothing_colors.length)];
  }

  function getContrastingColor(color: string) {
    const index = soothing_colors.indexOf(color);
    const oppositeIndex = (index + Math.floor(soothing_colors.length / 2)) % soothing_colors.length;
    return soothing_colors[oppositeIndex];
  }

  function updateColors() {
    const root = document.documentElement;
    const newTextColor = getRandomColor();
    const newBorderColor = getContrastingColor(newTextColor);

    root.style.setProperty('--neon-text-color', newTextColor);
    root.style.setProperty('--neon-border-color', newBorderColor);
  }

  // Update colors every 10 seconds
  updateColors();
  // const intervalId = setInterval(updateColors, 10000);

  // Add event listener for spacebar
  document.addEventListener('keydown', (event) => {
    if (event.code === 'Space') {
      event.preventDefault(); // Prevent scrolling
      updateColors();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const neonText = document.getElementById('neon-text');
    if (neonText) {
      neonText.addEventListener('touchstart', updateColors);
    }
  });

  // Clean up function to remove event listener and clear interval
  document.addEventListener('astro:page-load', () => {
    document.removeEventListener('keydown', updateColors);
    document.removeEventListener('touchstart', updateColors);
    // clearInterval(intervalId);
  });

  document.fonts.ready.then(() => {
    const neonText = document.getElementById('neon-text');
    if (neonText) {
      neonText.style.visibility = 'visible';
    }
  });
</script>