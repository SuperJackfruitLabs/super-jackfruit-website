---
import NeonText from '../NeonText.astro';
import { districts, byDistrict, projects } from '../../data/projects';
import '@fontsource-variable/inconsolata';
import '@fontsource/neonderthaw';
import '@fontsource/tilt-neon';

const statusCopy: Record<string, string> = {
  stable: 'lit & steady · open for business',
  wip: 'wet paint · mind the sparks',
  experiment: 'half-lit · enter at your own risk',
};
---

<div class="scene" id="scene">
  <canvas id="street-canvas"></canvas>

  <div class="overlay" id="entrance-overlay">
    <NeonText text="Super Jackfruit Labs" />
    <p class="overlay__script">the lab never closes</p>
    <p class="overlay__hint">walk in · browse the signs · everything's open</p>
  </div>

  <!-- fallback + crawlable content; shown when the 3D scene can't run -->
  <div class="fallback" id="fallback">
    <header class="fallback__head">
      <h1>Super Jackfruit Labs</h1>
      <p>the lab never closes</p>
    </header>
    {districts.map((d) => (
      <section class="fallback__district" style={`--accent: ${d.accent}`}>
        <h2>{d.name}</h2>
        <p class="fallback__blurb">{d.blurb}</p>
        <ul>
          {byDistrict(d.id).map((p) => (
            <li>
              <a href={p.github} target="_blank" rel="noopener noreferrer">{p.name}</a>
              <span class="fallback__tagline">{p.tagline}</span>
              <span class={`fallback__status fallback__status--${p.status}`}>{statusCopy[p.status]}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <footer class="fallback__foot">
      <a href="https://github.com/rakeshgangwar" target="_blank" rel="noopener noreferrer">github.com/rakeshgangwar</a>
      <a href="https://github.com/SuperJackfruitLabs" target="_blank" rel="noopener noreferrer">github.com/SuperJackfruitLabs</a>
    </footer>
  </div>
</div>

<style define:vars={{}}>
  .scene {
    position: fixed;
    inset: 0;
    background: #07070a;
    overflow: hidden;
  }

  #street-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    display: block;
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.4rem;
    text-align: center;
    padding: 0 6vw;
    pointer-events: none;
    /* own compositor layer: opacity changes and the marquee's shadow
       animation must never trigger repaints over the WebGL canvas */
    will-change: opacity;
    transform: translateZ(0);
  }

  .overlay__script {
    font-family: 'Neonderthaw', cursive;
    font-size: 3.4rem;
    color: #09e6f2;
    text-shadow: 0 0 8px rgba(9, 230, 242, 0.8), 0 0 24px rgba(9, 230, 242, 0.5);
    margin: 0;
  }

  .overlay__hint {
    font-family: 'Inconsolata Variable', monospace;
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    color: rgba(239, 233, 220, 0.6);
    margin: 0;
  }

  @media (max-width: 640px) {
    .overlay__script { font-size: 2.4rem; }
    .overlay__hint { font-size: 1.2rem; }
  }

  /* fallback list — hidden while the scene runs */
  .fallback {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    padding: 6rem 8vw;
    box-sizing: border-box;
    font-family: 'Inconsolata Variable', monospace;
    color: #efe9dc;
    display: none;
  }

  :global(body.no-webgl) .fallback { display: block; }
  :global(body.no-webgl) .overlay,
  :global(body.no-webgl) #street-canvas { display: none; }

  .fallback__head h1 {
    font-family: 'Tilt Neon', system-ui, sans-serif;
    font-weight: 400;
    font-size: 4.2rem;
    color: #fff;
    text-shadow: 0 0 12px #a12cf9, 0 0 40px #a12cf9;
    margin: 0;
  }

  .fallback__head p {
    font-family: 'Neonderthaw', cursive;
    font-size: 2.6rem;
    color: #09e6f2;
    margin: 0.4rem 0 3rem;
  }

  .fallback__district h2 {
    font-family: 'Tilt Neon', system-ui, sans-serif;
    font-weight: 400;
    font-size: 2.4rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent);
    margin: 3rem 0 0.2rem;
  }

  .fallback__blurb {
    font-family: 'Neonderthaw', cursive;
    font-size: 2.2rem;
    color: rgba(239, 233, 220, 0.7);
    margin: 0 0 1.2rem;
  }

  .fallback__district ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .fallback__district a {
    color: #fff;
    font-size: 1.7rem;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
  }

  .fallback__tagline {
    margin-left: 1.2rem;
    font-size: 1.4rem;
    color: rgba(239, 233, 220, 0.7);
  }

  .fallback__status {
    margin-left: 1.2rem;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
  }

  .fallback__status--stable { color: #0fe513; }
  .fallback__status--wip { color: #f2a707; }
  .fallback__status--experiment { color: #a12cf9; }

  .fallback__foot {
    display: flex;
    gap: 2.4rem;
    margin-top: 4rem;
  }

  .fallback__foot a {
    color: #bfee21;
    font-size: 1.5rem;
  }
</style>

<script>
  import { initStreetScene } from '../../scripts/street-scene';
  import { projects, districts } from '../../data/projects';

  const canvas = document.getElementById('street-canvas');
  const overlay = document.getElementById('entrance-overlay');

  if (canvas instanceof HTMLCanvasElement) {
    initStreetScene(canvas, projects, districts)
      .then((ok) => {
        if (!ok) document.body.classList.add('no-webgl');
      })
      .catch(() => document.body.classList.add('no-webgl'));
  }

  let lastOpacity = -1;
  window.addEventListener('street3d:progress', ((e: CustomEvent<{ progress: number }>) => {
    if (!overlay) return;
    const o = Math.round(Math.max(0, 1 - e.detail.progress * 3) * 100) / 100;
    if (o === lastOpacity) return; // don't touch style while standing still
    lastOpacity = o;
    overlay.style.opacity = String(o);
    overlay.style.visibility = o <= 0.01 ? 'hidden' : 'visible';
  }) as EventListener);
</script>
