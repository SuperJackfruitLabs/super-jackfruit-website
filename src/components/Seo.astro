---
/**
 * Canonical, Open Graph, Twitter card and the llms.txt pointer, for every layout. The title and
 * description are the page's own; the image is the one lab card, since no page has art of its own.
 */
interface Props {
  title: string;
  description: string;
  /** the 404 is a real page but not one to index or give a canonical */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/og.png', Astro.site).href;
const imageAlt = 'Super Jackfruit Labs: six tools for working with agents';
---

{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Super Jackfruit Labs" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
