<style>
  @import url("https://fonts.googleapis.com/css2?family=VT323&display=swap");

  .terminal-container {
    width: 100%;
    height: 300px;
    background: #000;
    color: #0f0;
    font-family: "VT323", monospace;
    font-size: x-large;
    padding: 10px;
    border-radius: 5px;
    overflow-y: auto;
  }

  .terminal-line {
    text-align: left; /* Left-align text */
  }

  .terminal-line::before {
    content: "$ ";
  }

  .terminal-input {
    background: #000;
    color: #0f0;
    border: none;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    font-size: x-large;
    font-family: "VT323", monospace;
  }

  .terminal-input::placeholder {
    color: #888; /* Change this to your desired placeholder color */
    font-family: "VT323", monospace; /* Change this to your desired placeholder font */
    font-size: x-large;
  }

  .terminal-input::before {
    content: "$ ";
    color: #0f0;
    font-family: "VT323", monospace;
    font-size: x-large;
  }
</style>

<div class="terminal-container">
  <p class="terminal-line">Welcome to Super Jackfruit Labs</p>
  <p class="terminal-line">
    Unlock Garage Access: Be the First to Know What's Coming Next.
  </p>
  <p class="terminal-line">Please enter your email to access:</p>
  <input
    type="text"
    placeholder="your email"
    class="terminal-input"
    id="terminal-input"
  />
</div>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    const terminalInput = document.getElementById("terminal-input");
    console.log(terminalInput);
    if (terminalInput !== null) {
      terminalInput.focus();
    }
  });
</script>
