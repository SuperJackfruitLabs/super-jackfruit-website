---
import Seo from '../components/Seo.astro';
import SuiteHead from '@superjackfruit/frontdoor/components/SuiteHead.astro';
import Frame from '@superjackfruit/frontdoor/components/Frame.astro';
import { frame } from '../data/frame';

/**
 * The village and the 404: pages whose body is one scene. The frontdoor frame (suite bar, lab
 * header, street footer) sits around the scene, so the page scrolls past it to the footer.
 */
interface Props {
  title: string;
  /**
   * Page-specific meta description. Omitted keeps the lab's own, which is right for the village
   * and wrong for a post — a feed reader and a search result both show this line.
   */
  description?: string;
}

const SITE_DESCRIPTION =
  'Super Jackfruit Labs builds six tools for working with agents. Drive through the village to meet them, from asking for work to proving it was done.';

const { title, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Seo {title} {description} noindex />
    <link rel="alternate" type="application/rss+xml" title="Super Jackfruit Labs" href="/rss.xml" />
    <slot name="head" />
    <SuiteHead product="lab" />
    <script is:inline>
      // Every deploy gives the assets new hashed names and drops the old ones.
      // A tab still holding the previous HTML then asks for files that are gone
      // and gets the 404 page back — "MIME type text/html" — and the page is
      // dead until someone reloads it. Recover once, automatically.
      (function () {
        var KEY = 'sjl-asset-reload';
        var failed = false;
        window.addEventListener(
          'error',
          function (e) {
            var el = e.target;
            if (!el || (el.tagName !== 'SCRIPT' && el.tagName !== 'LINK')) return;
            failed = true;
            try {
              if (sessionStorage.getItem(KEY)) return;
              sessionStorage.setItem(KEY, '1');
            } catch (err) {
              return;
            }
            location.reload();
          },
          true
        );
        window.addEventListener('load', function () {
          if (failed) return;
          try {
            sessionStorage.removeItem(KEY);
          } catch (err) {}
        });
      })();
    </script>
  </head>
  <body>
    <Frame product="lab" {...frame}>
      <slot />
    </Frame>
  </body>
</html>
<style is:global>
  :root {
    /* bumped to mint a fresh asset URL when an old one has to be abandoned */
    --build: 3;
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }
  html {
    font-family: system-ui, sans-serif;
    margin: 0;
    padding: 0;
  }
  body {
    margin: 0;
    background: #13151a;
  }
  html[data-theme='light'] body {
    background: #fbf8f4;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
</style>
