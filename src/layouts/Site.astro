---
import '@superjackfruit/vibekit/fonts.css';
import '@superjackfruit/vibekit/vibekit.css';
import SuiteHead from '@superjackfruit/frontdoor/components/SuiteHead.astro';
import Frame from '@superjackfruit/frontdoor/components/Frame.astro';
import { frame } from '../data/frame';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Super Jackfruit Labs builds six tools for working with agents, which together carry a task from ask to proof.' } = Astro.props;
---

<!doctype html>
<html lang="en" data-vibe="daylight" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍈</text></svg>" />
    <link rel="alternate" type="application/rss+xml" title="Super Jackfruit Labs" href="/rss.xml" />
    <title>{title}</title>
    <SuiteHead product="lab" />
  </head>
  <body>
    <!-- The frame owns the header, the light/dark switch and the footer; the page is Daylight. -->
    <Frame product="lab" {...frame}>
      <main><slot /></main>
    </Frame>
  </body>
</html>

<style is:global>
  body { background: var(--vk-color-bg); color: var(--vk-color-text); margin: 0; }
  main { width: 100%; max-width: 72rem; margin: 0 auto; padding: 0 16px 4rem; box-sizing: border-box; }
  a { color: inherit; }
  /* a product's own colours (from its logo) stand in for vibekit's accent inside it */
  [data-brand] {
    --vk-color-accent: var(--brand);
    --vk-color-accent-fg: var(--brand-fg);
    --vk-color-accent-text: var(--brand-ink);
  }
  html[data-theme='dark'] [data-brand] { --vk-color-accent-text: var(--brand); }
  .kicker { font-family: var(--vk-font-mono); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--vk-color-muted); }
  .btn { display: inline-block; padding: .65rem 1.1rem; border-radius: var(--vk-radius-md); background: var(--vk-color-accent); color: var(--vk-color-accent-fg); text-decoration: none; font-weight: 600; }
  .btn.ghost { background: transparent; color: var(--vk-color-text); border: 1px solid var(--vk-color-line); }
</style>
