---
interface Props {
  title: string;
  /**
   * Page-specific meta description. Omitted keeps the lab's own, which is right for the street and
   * the village and wrong for a post — a feed reader and a search result both show this line.
   */
  description?: string;
  /**
   * Let the page scroll.
   *
   * `html { overflow: hidden }` below exists for the full-screen pages: the neon street and the
   * village are fixed viewports where a scrollbar would be a bug. Prose is the opposite, and a
   * blog post that cannot scroll is a blog post nobody can read past the fold. Opt-in rather than
   * opt-out so every existing page behaves exactly as it did.
   */
  scroll?: boolean;
}

const SITE_DESCRIPTION =
  'Super Jackfruit Labs builds six tools for working with agents. Drive through the village to meet them, from asking for work to proving it was done.';

const { title, description = SITE_DESCRIPTION, scroll = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      // Every deploy gives the assets new hashed names and drops the old ones.
      // A tab still holding the previous HTML then asks for files that are gone
      // and gets the 404 page back — "MIME type text/html" — and the page is
      // dead until someone reloads it. Recover once, automatically.
      (function () {
        var KEY = 'sjl-asset-reload';
        var failed = false;
        window.addEventListener(
          'error',
          function (e) {
            var el = e.target;
            if (!el || (el.tagName !== 'SCRIPT' && el.tagName !== 'LINK')) return;
            failed = true;
            try {
              if (sessionStorage.getItem(KEY)) return;
              sessionStorage.setItem(KEY, '1');
            } catch (err) {
              return;
            }
            location.reload();
          },
          true
        );
        window.addEventListener('load', function () {
          if (failed) return;
          try {
            sessionStorage.removeItem(KEY);
          } catch (err) {}
        });
      })();
    </script>
  </head>
  <body class={scroll ? "is-scrollable" : undefined}>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    /* bumped to mint a fresh asset URL when an old one has to be abandoned */
    --build: 3;
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }
  html {
    font-family: system-ui, sans-serif;
    background: #13151a;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  /* `scroll` pages only. `:has` keeps the rule with the rest of the shell instead of shipping a
     second global stylesheet, and every browser this site targets supports it. */
  html:has(body.is-scrollable) {
    height: auto;
    overflow: visible;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
</style>
