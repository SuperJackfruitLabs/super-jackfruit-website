---
import Site from '../../layouts/Site.astro';
import { suite, accentAttrs, type Product } from '../../data/suite';

export function getStaticPaths() {
  return suite.map((p, i) => ({ params: { slug: p.slug }, props: { p, i } }));
}

const { p, i } = Astro.props as { p: Product; i: number };
const prev = suite[i - 1];
const next = suite[i + 1];
---

<Site title={`${p.name} — Super Jackfruit Labs`} description={p.summary}>
  <article {...accentAttrs(p)}>
    <p class="kicker">Step {i + 1} of {suite.length} · {p.step}</p>
    <h1><img class="logo" src={`/brand/${p.slug}.svg`} alt="" width="72" height="72" />{p.name}</h1>
    <p class="headline">{p.headline}</p>
    <p class="lede">{p.summary}</p>
    <p class="status" data-released={p.status === 'Released' ? 'yes' : 'no'}>● {p.status}{p.version ? ` · ${p.version}` : ''} <span>checked {p.checked}</span></p>
    <ul class="features">{p.features.map((f) => <li>{f}</li>)}</ul>
    <div class="actions">
      <a class="btn" href={p.cta.href}>{p.cta.label}</a>
      {p.links.map((l) => <a class="btn ghost" href={l.href}>{l.label}</a>)}
    </div>
    <p class="alone">In its own words, from <a href={p.site}>{new URL(p.site).host}</a>.</p>
  </article>
  <nav class="steps">
    {prev ? <a href={`/products/${prev.slug}`}>← {prev.step}: {prev.name}</a> : <span />}
    {next ? <a href={`/products/${next.slug}`}>{next.step}: {next.name} →</a> : <a href="/#products">Back to the suite →</a>}
  </nav>
</Site>

<style>
  article { padding: 3rem 0 2rem; max-width: 44rem; }
  h1 { font-family: var(--vk-font-display); font-size: clamp(2.25rem, 6vw, 3.5rem); margin: .25rem 0 1rem; color: var(--vk-color-accent-text); }
  h1 { display: flex; align-items: center; gap: .9rem; }
  h1 .logo { width: 1.25em; height: 1.25em; flex: none; }
  .headline { font-family: var(--vk-font-display); font-size: clamp(1.4rem, 3.5vw, 1.9rem); line-height: 1.2; margin: 0 0 .75rem; }
  .lede { font-size: 1.2rem; line-height: 1.5; }
  .status { color: var(--vk-color-success-text); font-size: .9rem; }
  .status span { color: var(--vk-color-faint); margin-left: .5rem; }
  .features { padding: 0; list-style: none; display: grid; gap: .5rem; margin: 1.5rem 0; }
  .features li { padding: .75rem 1rem; border-left: 3px solid var(--vk-color-accent); background: var(--vk-color-surface); border-radius: var(--vk-radius-sm); }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; }
  .alone { color: var(--vk-color-muted); margin-top: 2rem; }
  .steps { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--vk-color-line); padding-top: 1rem; }
  .steps a { color: var(--vk-color-muted); }
  /* not yet released reads neutral, not as the green of a release */
  .status[data-released='no'] { color: var(--vk-color-muted); }
</style>
