---
import Layout from '../layouts/Layout.astro';
import '@fontsource-variable/inconsolata';
---

<Layout title="Super Jackfruit Labs — the village">
  <div class="scene">
    <canvas id="village-canvas"></canvas>
    <p class="hint">w / ↑ drive · a d steer · s brake &amp; reverse · shift nitro · m mute</p>
    <p class="tag">the village — work in progress</p>
    <p class="credit">music: yd · engine: qubodup (CC-BY, opengameart) · car: Han66st (CC-BY, sketchfab)</p>

    <div class="env">
      <!-- time reads as one track the day moves along, not four loose buttons -->
      <div class="env__group env__group--track" id="time-row" role="group" aria-label="Time of day">
        <button type="button" data-time="dawn" aria-pressed="false" aria-label="Dawn" title="Dawn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h18M7.5 18a4.5 4.5 0 0 1 9 0M12 3.5v4M9.5 6 12 3.5 14.5 6M4.8 10.2l1.6 1.6M19.2 10.2l-1.6 1.6"/></svg>
        </button>
        <button type="button" data-time="day" aria-pressed="false" aria-label="Day" title="Day">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.4 4.4 6 6M18 18l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.4 19.6 6 18M18 6l1.6-1.6"/></svg>
        </button>
        <button type="button" data-time="dusk" data-active="true" aria-pressed="true" aria-label="Dusk" title="Dusk">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h18M7.5 18a4.5 4.5 0 0 1 9 0M12 7.5v-4M9.5 5 12 7.5 14.5 5M4.8 10.2l1.6 1.6M19.2 10.2l-1.6 1.6"/></svg>
        </button>
        <button type="button" data-time="night" aria-pressed="false" aria-label="Night" title="Night">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/></svg>
        </button>
      </div>

      <!-- a season is always one or the other, so it's a single leaf that turns -->
      <div class="env__group">
        <button type="button" id="season-toggle" class="env__leaf" data-season-state="summer" aria-label="Season: summer. Switch to autumn" title="Season">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-7.5 4.8-12.2 15-13 0 10.2-4.8 15-12 15H5Z"/><path d="M9 16c1.8-2.8 4.4-4.8 7.2-5.8"/></svg>
        </button>
      </div>

      <div class="env__group">
        <button type="button" id="quality-toggle" class="env__quality" data-tier="high" aria-label="Graphics: high. Change" title="Graphics">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect class="q1" x="4" y="14" width="4" height="6" rx="1"/><rect class="q2" x="10" y="9.5" width="4" height="10.5" rx="1"/><rect class="q3" x="16" y="5" width="4" height="15" rx="1"/></svg>
        </button>
      </div>

      <div class="env__group" id="audio-row" role="group" aria-label="Sound">
        <button type="button" data-audio="music" data-active="true" aria-pressed="true" aria-label="Music" title="Music">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 17.5V5.2l10-2v12.3"/><circle cx="6.6" cy="17.6" r="2.4"/><circle cx="16.6" cy="15.5" r="2.4"/><line class="env__slash" x1="4.2" y1="19.8" x2="19.8" y2="4.2"/></svg>
        </button>
        <button type="button" data-audio="engine" data-active="true" aria-pressed="true" aria-label="Engine" title="Engine">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 15.5 5.3 10a2 2 0 0 1 1.9-1.4h9.6A2 2 0 0 1 18.7 10l1.8 5.5v2.6h-2.1M5.6 18.1H3.5v-2.6M3.5 15.5h17"/><circle cx="7.8" cy="18.1" r="1.7"/><circle cx="16.2" cy="18.1" r="1.7"/><line class="env__slash" x1="4.2" y1="19.8" x2="19.8" y2="4.2"/></svg>
        </button>
      </div>
    </div>

    <p class="visited" id="visited-chip" hidden>projects visited: <span id="visited-count">0/15</span></p>

    <div class="welcome" id="welcome" data-open="true">
      <div class="welcome__card">
        <h1>Super Jackfruit Labs</h1>
        <p class="welcome__sub">an open-source lab you can drive through</p>
        <div
          class="welcome__bar"
          id="welcome-bar"
          role="progressbar"
          aria-label="loading the village"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <span class="welcome__fill" id="welcome-fill"></span>
        </div>
        <p class="welcome__hint" id="welcome-hint">loading the village…</p>
      </div>
    </div>

    <!-- on-screen driving, for anyone without a keyboard -->
    <div class="touch" id="touch" hidden>
      <div class="touch__wheel" id="touch-steer" aria-label="steer">
        <span class="touch__knob" id="touch-knob"></span>
        <span class="touch__wheel-label">steer</span>
      </div>
      <div class="touch__pedals">
        <button class="touch__btn touch__btn--nitro" id="touch-nitro" type="button" aria-label="nitro">N</button>
        <button class="touch__btn touch__btn--brake" id="touch-brake" type="button" aria-label="brake and reverse">▼</button>
        <button class="touch__btn touch__btn--gas" id="touch-gas" type="button" aria-label="accelerate">▲</button>
      </div>
    </div>

    <aside class="card" id="station-card" data-open="false" aria-live="polite">
      <h2 id="card-name"></h2>
      <p class="card__tagline" id="card-tagline"></p>
      <p class="card__status" id="card-status"></p>
      <p class="card__desc" id="card-desc"></p>
      <p class="card__tags" id="card-tags"></p>
      <div class="card__actions">
        <a id="card-github" href="#" target="_blank" rel="noopener noreferrer">view source →</a>
        <a id="card-demo" href="#" target="_blank" rel="noopener noreferrer" hidden>live demo →</a>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .scene {
    --build: 3;
    position: fixed;
    inset: 0;
    background: #9ed4f5;
    font-family: 'Inconsolata Variable', monospace;
  }

  #village-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }

  .hint,
  .tag {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    pointer-events: none;
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.6);
  }

  .hint {
    bottom: 2.2rem;
    font-size: 1.5rem;
    color: rgba(40, 50, 60, 0.85);
  }

  .tag {
    top: 1.6rem;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    color: rgba(40, 50, 60, 0.55);
  }

  .env {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* each group is its own pill, so the grouping is the only label needed */
  .env__group {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    border: 1.5px solid rgba(40, 50, 60, 0.16);
    backdrop-filter: blur(4px);
  }

  .env button {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(40, 50, 60, 0.62);
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .env button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .env button:hover { color: rgba(40, 50, 60, 0.95); }

  .env button[data-active='true'] {
    background: rgba(40, 50, 60, 0.86);
    color: #f6f0e2;
  }

  .env button:focus-visible {
    outline: 2px solid #d98a1f;
    outline-offset: 2px;
  }

  /* A season is always one or the other, so the leaf is always filled — same
     "filled = current" language as the other two groups — and carries the
     season in its hue rather than inventing a second visual state. */
  /* qualified with `button` on purpose: scoping turns `.env button` into a
     higher-specificity selector than a bare class + attribute, so without the
     type selector here the transparent background wins and the leaf stays grey */
  .env button.env__leaf { color: #f6f0e2; }
  .env button.env__leaf[data-season-state='summer'] { background: rgba(58, 132, 68, 0.92); }
  .env button.env__leaf[data-season-state='autumn'] { background: rgba(190, 112, 24, 0.94); }
  .env button.env__leaf:hover { color: #fffaf0; }

  /* graphics: bars for the level, always filled because there is always a level */
  .env button.env__quality { background: rgba(40, 50, 60, 0.86); color: #f6f0e2; }
  .env button.env__quality svg rect { fill: currentColor; stroke: none; }
  .env button.env__quality[data-tier='low'] .q2,
  .env button.env__quality[data-tier='low'] .q3,
  .env button.env__quality[data-tier='medium'] .q3 { opacity: 0.3; }

  /* a struck-through icon is off; no second state to learn */
  .env button[data-active='true'] .env__slash { display: none; }
  .env__slash { stroke-width: 1.9; }

  @media (prefers-reduced-motion: reduce) {
    .env button { transition: none; }
  }

  .credit {
    position: absolute;
    right: 1.2rem;
    bottom: 0.9rem;
    left: auto;
    transform: none;
    margin: 0;
    font-size: 0.95rem;
    color: rgba(40, 50, 60, 0.45);
    pointer-events: none;
  }

  /* the project card — warm paper, day theme */
  .card {
    position: absolute;
    left: 2.4rem;
    bottom: 2.4rem;
    width: min(37rem, calc(100vw - 4.8rem));
    background: #f6f0e2;
    color: #2c2a26;
    border: 3px solid var(--accent, #d98a1f);
    border-radius: 12px;
    padding: 2rem 2.2rem;
    box-shadow: 0 10px 30px rgba(40, 50, 60, 0.25);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .card[data-open='true'] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .card h2 {
    margin: 0 0 0.2rem;
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .card__tagline {
    margin: 0 0 1rem;
    font-size: 1.35rem;
    color: rgba(44, 42, 38, 0.75);
  }

  .card__status {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    color: rgba(44, 42, 38, 0.6);
  }

  .card__status::before {
    content: '● ';
    color: var(--status-color, #3f9e3f);
  }

  .card__desc {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    line-height: 1.55;
  }

  .card__tags {
    margin: 0 0 1.4rem;
    font-size: 1.15rem;
    color: rgba(44, 42, 38, 0.6);
  }

  .card__actions {
    display: flex;
    gap: 1.4rem;
  }

  .card__actions a {
    font-size: 1.3rem;
    font-weight: 700;
    color: #2c2a26;
    text-decoration: none;
    border-bottom: 2px solid var(--accent, #d98a1f);
    padding-bottom: 0.1rem;
  }

  .card__actions a:hover,
  .card__actions a:focus-visible {
    color: var(--accent, #d98a1f);
    outline: none;
  }

  .visited {
    position: absolute;
    left: 1.4rem;
    top: 1.4rem;
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: rgba(40, 50, 60, 0.7);
    background: rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    padding: 0.35rem 0.95rem;
    pointer-events: none;
  }

  .visited.done { background: rgba(63, 158, 63, 0.85); color: #f6f0e2; }

  .welcome {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(158, 212, 245, 0.92);
    transition: opacity 0.6s ease;
    z-index: 10;
  }

  .welcome[data-open='false'] { opacity: 0; pointer-events: none; }

  .welcome__card {
    text-align: center;
    background: #f6f0e2;
    border: 3px solid #d98a1f;
    border-radius: 14px;
    padding: 3rem 4rem;
    box-shadow: 0 14px 40px rgba(40, 50, 60, 0.25);
  }

  .welcome__card h1 {
    margin: 0 0 0.4rem;
    font-size: 2.6rem;
    font-weight: 700;
    color: #2c2a26;
  }

  .welcome__sub { margin: 0 0 1.6rem; font-size: 1.4rem; color: rgba(44, 42, 38, 0.7); }

  .welcome__bar {
    height: 6px;
    width: min(22rem, 60vw);
    margin: 0 auto 1rem;
    border-radius: 999px;
    background: rgba(44, 42, 38, 0.14);
    overflow: hidden;
  }

  .welcome__fill {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: #d98a1f;
    transition: width 0.3s ease;
  }

  .welcome__hint {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    color: rgba(44, 42, 38, 0.55);
  }

  .welcome__hint[data-ready='true'] { animation: welcome-pulse 1.6s ease-in-out infinite; }

  @keyframes welcome-pulse { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .welcome__hint[data-ready='true'] { animation: none; }
    .welcome__fill { transition: none; }
  }

  /* ---------- on-screen driving ---------- */
  .touch {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 1.1rem calc(1.1rem + env(safe-area-inset-bottom));
    pointer-events: none;
    z-index: 5;
  }

  /* an author `display` beats the UA rule for [hidden], so say it explicitly */
  .touch[hidden] { display: none; }

  .touch > * { pointer-events: auto; }

  .touch__wheel {
    position: relative;
    width: min(15rem, 42vw);
    height: 4.6rem;
    border-radius: 999px;
    border: 2px solid rgba(40, 50, 60, 0.28);
    background: rgba(255, 255, 255, 0.42);
    touch-action: none;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(3px);
  }

  .touch__knob {
    position: absolute;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: rgba(40, 50, 60, 0.82);
    transition: transform 0.08s ease-out;
  }

  .touch__wheel-label {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: rgba(40, 50, 60, 0.5);
    transform: translateY(2.9rem);
  }

  .touch__pedals {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas: 'nitro gas' 'brake gas';
    gap: 0.55rem;
    align-items: center;
  }

  .touch__btn {
    font-family: 'Inconsolata Variable', monospace;
    font-weight: 700;
    border-radius: 999px;
    border: 2px solid rgba(40, 50, 60, 0.28);
    background: rgba(255, 255, 255, 0.42);
    color: rgba(40, 50, 60, 0.8);
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    backdrop-filter: blur(3px);
  }

  .touch__btn[data-active='true'] {
    background: rgba(40, 50, 60, 0.82);
    color: #f6f0e2;
    border-color: transparent;
  }

  .touch__btn--gas { grid-area: gas; width: 5.6rem; height: 5.6rem; font-size: 2rem; }
  .touch__btn--brake { grid-area: brake; width: 4rem; height: 4rem; font-size: 1.4rem; }
  .touch__btn--nitro { grid-area: nitro; width: 4rem; height: 4rem; font-size: 1.3rem; }

  /* the keyboard legend is meaningless once the pedals are up */
  .scene[data-touch='true'] .hint { display: none; }
  .scene[data-touch='true'] .env button { width: 2.75rem; height: 2.75rem; }
  .scene[data-touch='true'] .env button svg { width: 1.4rem; height: 1.4rem; }
  /* tucked under the visited chip — the bottom belongs to the controls now */
  .scene[data-touch='true'] .credit {
    bottom: auto;
    top: 3.9rem;
    left: 1.4rem;
    right: auto;
    font-size: 0.75rem;
  }
  .scene[data-touch='true'] .card { bottom: 9.5rem; }

  @media (max-width: 640px) {
    .card {
      left: 1.2rem;
      bottom: 5.4rem;
      padding: 1.4rem 1.6rem;
    }
    .hint { font-size: 1.2rem; bottom: 1.2rem; }
  }
</style>

<script>
  import { initVillageScene } from '../scripts/village-scene';

  const canvas = document.getElementById('village-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    initVillageScene(canvas).catch((e) => console.error(e));
  }

  const STATUS_COPY: Record<string, string> = {
    stable: 'lit & steady · open for business',
    wip: 'wet paint · mind the sparks',
    experiment: 'half-lit · enter at your own risk',
  };
  const STATUS_COLOR: Record<string, string> = {
    stable: '#3f9e3f',
    wip: '#d98a1f',
    experiment: '#8a5fc9',
  };

  const card = document.getElementById('station-card')!;
  const nameEl = document.getElementById('card-name')!;
  const taglineEl = document.getElementById('card-tagline')!;
  const statusEl = document.getElementById('card-status')!;
  const descEl = document.getElementById('card-desc')!;
  const tagsEl = document.getElementById('card-tags')!;
  const githubEl = document.getElementById('card-github') as HTMLAnchorElement;
  const demoEl = document.getElementById('card-demo') as HTMLAnchorElement;

  interface StationDetail {
    kind: 'project' | 'info';
    project?: {
      name: string;
      tagline: string;
      description: string;
      tags: string[];
      status: string;
      github: string;
      demo?: string;
    };
    info?: { title: string; tagline: string; lines: string[]; links: Array<{ label: string; url: string }> };
    accent: string;
  }

  // time of day: one active segment at a time
  const timeRow = document.getElementById('time-row')!;
  timeRow.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn || !btn.dataset.time) return;
    for (const b of timeRow.querySelectorAll('button')) {
      b.dataset.active = 'false';
      b.setAttribute('aria-pressed', 'false');
    }
    btn.dataset.active = 'true';
    btn.setAttribute('aria-pressed', 'true');
    window.dispatchEvent(new CustomEvent('village:time', { detail: btn.dataset.time }));
  });

  // graphics: cycles through the tiers, showing the level as filled bars
  const TIERS = ['low', 'medium', 'high'] as const;
  const qualityBtn = document.getElementById('quality-toggle')!;
  const showTier = (tier: string) => {
    qualityBtn.dataset.tier = tier;
    qualityBtn.setAttribute('aria-label', `Graphics: ${tier}. Change`);
  };
  qualityBtn.addEventListener('click', () => {
    const i = TIERS.indexOf((qualityBtn.dataset.tier ?? 'high') as (typeof TIERS)[number]);
    const next = TIERS[(i + 1) % TIERS.length];
    showTier(next);
    window.dispatchEvent(new CustomEvent('village:quality', { detail: next }));
  });
  // the scene decides the opening tier, and may drop one if the device struggles
  window.addEventListener('village:quality-changed', ((e: CustomEvent<string>) => showTier(e.detail)) as EventListener);

  // season: a single leaf that turns
  const seasonBtn = document.getElementById('season-toggle')!;
  seasonBtn.addEventListener('click', () => {
    const next = seasonBtn.dataset.seasonState === 'summer' ? 'autumn' : 'summer';
    seasonBtn.dataset.seasonState = next;
    seasonBtn.setAttribute(
      'aria-label',
      next === 'summer' ? 'Season: summer. Switch to autumn' : 'Season: autumn. Switch to summer'
    );
    window.dispatchEvent(new CustomEvent('village:season', { detail: next }));
  });

  window.addEventListener('village:station', ((e: CustomEvent<StationDetail | null>) => {
    if (!e.detail) {
      card.dataset.open = 'false';
      return;
    }
    const { accent } = e.detail;
    card.style.setProperty('--accent', accent);
    if (e.detail.kind === 'info' && e.detail.info) {
      const info = e.detail.info;
      nameEl.textContent = info.title;
      taglineEl.textContent = info.tagline;
      statusEl.textContent = '';
      statusEl.setAttribute('hidden', '');
      descEl.textContent = info.lines.join(' ');
      tagsEl.textContent = '';
      githubEl.textContent = info.links[0]?.label ?? '';
      githubEl.href = info.links[0]?.url ?? '#';
      if (info.links[1]) {
        demoEl.textContent = info.links[1].label;
        demoEl.href = info.links[1].url;
        demoEl.hidden = false;
      } else {
        demoEl.hidden = true;
      }
      card.dataset.open = 'true';
      return;
    }
    const project = e.detail.project!;
    nameEl.textContent = project.name;
    taglineEl.textContent = project.tagline;
    statusEl.removeAttribute('hidden');
    statusEl.textContent = STATUS_COPY[project.status] ?? project.status;
    descEl.textContent = project.description;
    tagsEl.textContent = project.tags.map((t) => `[${t}]`).join('  ');
    githubEl.textContent = 'view source →';
    githubEl.href = project.github;
    if (project.demo) {
      demoEl.textContent = 'live demo →';
      demoEl.href = project.demo;
      demoEl.hidden = false;
    } else {
      demoEl.hidden = true;
    }
    card.style.setProperty('--status-color', STATUS_COLOR[project.status] ?? '#3f9e3f');
    card.dataset.open = 'true';
  }) as EventListener);

  // visited counter
  const visitedChip = document.getElementById('visited-chip')!;
  const visitedCount = document.getElementById('visited-count')!;
  window.addEventListener('village:visited', ((e: CustomEvent<{ count: number; total: number }>) => {
    visitedChip.hidden = false;
    visitedCount.textContent = `${e.detail.count}/${e.detail.total}`;
    if (e.detail.count === e.detail.total) visitedChip.classList.add('done');
  }) as EventListener);

  // welcome overlay: holds a real progress bar while the village downloads,
  // then any input enters (which doubles as the audio unlock gesture)
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  const welcome = document.getElementById('welcome')!;
  const welcomeBar = document.getElementById('welcome-bar')!;
  const welcomeFill = document.getElementById('welcome-fill')!;
  const welcomeHint = document.getElementById('welcome-hint')!;
  let ready = false;

  window.addEventListener('village:loading', ((e: CustomEvent<number>) => {
    const pct = Math.round(e.detail * 100);
    welcomeFill.style.width = `${pct}%`;
    welcomeBar.setAttribute('aria-valuenow', String(pct));
  }) as EventListener);

  window.addEventListener('village:ready', () => {
    ready = true;
    welcomeFill.style.width = '100%';
    welcomeBar.setAttribute('aria-valuenow', '100');
    welcomeBar.hidden = true;
    welcomeHint.textContent = isTouch ? 'tap to enter' : 'press any key or tap to enter';
    welcomeHint.dataset.ready = 'true';
  });

  function enterVillage() {
    if (!ready) return;
    welcome.dataset.open = 'false';
    window.removeEventListener('keydown', enterVillage);
    welcome.removeEventListener('pointerdown', enterVillage);
  }
  window.addEventListener('keydown', enterVillage);
  welcome.addEventListener('pointerdown', enterVillage);

  // ---------- on-screen driving ----------
  if (isTouch) {
    document.querySelector('.scene')?.setAttribute('data-touch', 'true');
    const panel = document.getElementById('touch')!;
    panel.hidden = false;

    const touchState = { steer: 0, throttle: 0, nitro: false };
    const push = () => window.dispatchEvent(new CustomEvent('village:touch', { detail: { ...touchState } }));

    const wheel = document.getElementById('touch-steer')!;
    const knob = document.getElementById('touch-knob')!;
    let steerPointer: number | null = null;
    // 2.4 rather than 2.0 so full lock arrives before the thumb runs out of pad
    const readSteer = (e: PointerEvent) => {
      const r = wheel.getBoundingClientRect();
      touchState.steer = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width - 0.5) * 2.4));
      knob.style.transform = `translateX(${touchState.steer * 145}%)`;
      push();
    };
    wheel.addEventListener('pointerdown', (e) => {
      steerPointer = e.pointerId;
      wheel.setPointerCapture(e.pointerId);
      readSteer(e);
    });
    wheel.addEventListener('pointermove', (e) => {
      if (e.pointerId === steerPointer) readSteer(e);
    });
    for (const type of ['pointerup', 'pointercancel'] as const) {
      wheel.addEventListener(type, (e) => {
        if (e.pointerId !== steerPointer) return;
        steerPointer = null;
        touchState.steer = 0;
        knob.style.transform = 'translateX(0%)';
        push();
      });
    }

    const hold = (el: HTMLElement, on: () => void, off: () => void) => {
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        el.setPointerCapture(e.pointerId);
        el.dataset.active = 'true';
        on();
        push();
      });
      for (const type of ['pointerup', 'pointercancel'] as const) {
        el.addEventListener(type, () => {
          el.dataset.active = 'false';
          off();
          push();
        });
      }
    };
    hold(document.getElementById('touch-gas')!, () => (touchState.throttle = 1), () => (touchState.throttle = 0));
    hold(document.getElementById('touch-brake')!, () => (touchState.throttle = -1), () => (touchState.throttle = 0));
    hold(document.getElementById('touch-nitro')!, () => (touchState.nitro = true), () => (touchState.nitro = false));
  }

  // separate audio toggles
  document.getElementById('audio-row')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn || !btn.dataset.audio) return;
    const on = btn.dataset.active !== 'true';
    btn.dataset.active = String(on);
    btn.setAttribute('aria-pressed', String(on));
    window.dispatchEvent(new CustomEvent('village:audio', { detail: { channel: btn.dataset.audio, on } }));
  });
</script>
