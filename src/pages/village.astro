---
import Layout from '../layouts/Village.astro';
import { CARS } from '../scripts/village/cars';
import { byDistrict } from '../data/projects';
import '@fontsource-variable/inconsolata';

// the places the menu lists: the suite in flow order, then the lab and its guide
const SUITE_PLACES = byDistrict('agent-works');
const linkLabel = (url: string) => (url.startsWith('/') ? 'page' : new URL(url).host);
import '@superjackfruit/vibekit/fonts.css';
---

<Layout title="The village — Super Jackfruit Labs" description="Drive through the Super Jackfruit Labs village and meet the six tools for working with agents, from asking for work to proving it was done.">
  <div class="scene">
    <canvas id="village-canvas"></canvas>
    <p class="hint">w / ↑ drive · a d steer · s brake &amp; reverse · shift nitro · m mute · ? keys</p>
    <!-- the only controls always on screen: the map, sound, and the menu with everything else -->
    <div class="hud">
      <button type="button" id="map-toggle" class="hud__btn" aria-expanded="false" aria-controls="places-panel" aria-label="Map and places" title="Map and places" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5 9 4.5l6 2 5.5-2v13l-5.5 2-6-2-5.5 2Z"/><path d="M9 4.5v13M15 6.5v13"/></svg>
      </button>
      <button type="button" id="sound-toggle" class="hud__btn" aria-pressed="true" aria-label="Sound on. Mute" title="Sound (m)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4Z"/><path class="hud__wave" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/><line class="hud__slash" x1="15" y1="9" x2="21" y2="15"/><line class="hud__slash" x1="21" y1="9" x2="15" y2="15"/></svg>
      </button>
      <button type="button" id="menu-toggle" class="hud__btn" aria-expanded="false" aria-controls="menu" aria-label="Settings" title="Settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 7h15M4.5 12h15M4.5 17h15"/></svg>
      </button>
    </div>

    <!-- the map is a picture of what the menu and the cards already say in words -->
    <div class="minimap" id="minimap" aria-hidden="true" hidden><canvas id="minimap-canvas"></canvas></div>
    <p class="sr-only">A small map in the corner shows the streets around your car, the six suite houses and the lab's square. The same places are listed under Suite in the menu.</p>

    <!-- the map button's panel: the minimap switch, and every place with its links -->
    <div class="env menu places" id="places-panel" role="dialog" aria-modal="true" aria-label="Map and places" hidden>
      <span class="menu__label" id="minimap-label">Minimap</span>
      <div class="env__group">
        <button type="button" id="minimap-switch" class="env__auto" aria-pressed="true" aria-labelledby="minimap-label minimap-state"><span id="minimap-state">shown</span> <span class="menu__key" aria-hidden="true">N</span></button>
      </div>
      <!-- every place worth stopping at, as plain links: the way in for anyone not driving -->
      <span class="menu__label menu__label--wide" id="places-label">Places</span>
      <ul class="menu__places" aria-labelledby="places-label">
        {SUITE_PLACES.map((p) => (
          <li data-slug={p.slug} style={`--dot: ${p.accent ?? '#d98a1f'}`}>
            <span class="place__name">{p.name}<span class="place__tick" hidden> ✓<span class="sr-only"> visited</span></span></span>
            <a href={p.github} target="_blank" rel="noopener noreferrer">{linkLabel(p.github)}<span class="sr-only"> ({p.name} website)</span></a>
            {p.demo && <a href={p.demo} target="_blank" rel="noopener noreferrer">docs<span class="sr-only"> ({p.name})</span></a>}
            <button type="button" class="env__auto place__go" data-jump={p.slug}>drive here<span class="sr-only"> to {p.name}</span></button>
          </li>
        ))}
        <li style="--dot: #8a5a1a">
          <span class="place__name">The lab's square</span>
          <a href="/">the suite as a page</a>
          <a href="mailto:rakesh@superjackfruit.com">write to us</a>
          <button type="button" class="env__auto place__go" data-jump="hq">drive here<span class="sr-only"> to the lab's square</span></button>
        </li>
        <li style="--dot: #173d83">
          <span class="place__name">Captain Jack's house</span>
          <a href="#captain-jack" data-ask>talk to him</a>
          <button type="button" class="env__auto place__go" data-jump="captain-jack">drive here<span class="sr-only"> to Captain Jack's house</span></button>
        </li>
      </ul>

    </div>

    <div class="env menu" id="menu" role="dialog" aria-modal="true" aria-label="Settings" hidden>
      <!-- the suite as a page, and how much of it you've driven past: kept here, off the screen -->
      <!-- the garage: thumbnails come from the same list the scene drives, see cars.ts -->
      <span class="menu__label menu__label--wide">Car</span>
      <div class="menu__cars" id="car-row" role="group" aria-label="Car">
        {CARS.map((c) => (
          <button type="button" class="menu__car" data-car={c.id} aria-pressed="false" title={c.name}>
            <img src={c.thumb} alt="" width="80" height="48" loading="lazy" decoding="async" />
            <span>{c.name}</span>
          </button>
        ))}
      </div>
      <span class="menu__label" id="paint-label" hidden>Paint</span>
      <div class="env__group menu__paints" id="paint-row" role="group" aria-label="Paint" hidden></div>
      <p class="menu__car-note" id="car-note" aria-live="polite"></p>

      <span class="menu__label">Suite</span>
      <div class="menu__suite">
        <a href="/">see it as a page →</a>
        <span class="visited" id="visited-chip" hidden>visited <span id="visited-count">0/6</span></span>
      </div>
      <!-- the cards that rise beside each house; off, a one-line chip says where you are instead -->
      <span class="menu__label" id="cards-label">Place cards</span>
      <div class="env__group">
        <button type="button" id="cards-toggle" class="env__auto" aria-pressed="true" aria-labelledby="cards-label cards-state"><span id="cards-state">shown</span></button>
      </div>
      <p class="menu__car-note">Every place, and the way to it, is under the map button.</p>

      <span class="menu__label">Time</span>
      <!-- time reads as one track the day moves along, not four loose buttons -->
      <div class="env__group env__group--track" id="time-row" role="group" aria-label="Time of day">
        <button type="button" data-time="auto" data-active="true" aria-pressed="true" aria-label="Follow my clock" title="Follow my clock" class="env__auto">auto</button>
        <button type="button" data-time="dawn" aria-pressed="false" aria-label="Dawn" title="Dawn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h18M7.5 18a4.5 4.5 0 0 1 9 0M12 3.5v4M9.5 6 12 3.5 14.5 6M4.8 10.2l1.6 1.6M19.2 10.2l-1.6 1.6"/></svg>
        </button>
        <button type="button" data-time="day" aria-pressed="false" aria-label="Day" title="Day">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.4 4.4 6 6M18 18l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.4 19.6 6 18M18 6l1.6-1.6"/></svg>
        </button>
        <button type="button" data-time="dusk" aria-pressed="false" aria-label="Dusk" title="Dusk">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h18M7.5 18a4.5 4.5 0 0 1 9 0M12 7.5v-4M9.5 5 12 7.5 14.5 5M4.8 10.2l1.6 1.6M19.2 10.2l-1.6 1.6"/></svg>
        </button>
        <button type="button" data-time="night" aria-pressed="false" aria-label="Night" title="Night">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/></svg>
        </button>
      </div>

      <!-- a season is always one or the other, so it's a single leaf that turns -->
      <span class="menu__label">Season</span>
      <div class="env__group">
        <button type="button" id="season-toggle" class="env__leaf" data-season-state="summer" aria-label="Season: summer. Switch to autumn" title="Season">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-7.5 4.8-12.2 15-13 0 10.2-4.8 15-12 15H5Z"/><path d="M9 16c1.8-2.8 4.4-4.8 7.2-5.8"/></svg>
        </button>
      </div>

      <span class="menu__label">Graphics</span>
      <div class="env__group">
        <button type="button" id="quality-toggle" class="env__quality" data-tier="high" aria-label="Graphics: high. Change" title="Graphics">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect class="q1" x="4" y="14" width="4" height="6" rx="1"/><rect class="q2" x="10" y="9.5" width="4" height="10.5" rx="1"/><rect class="q3" x="16" y="5" width="4" height="15" rx="1"/></svg>
        </button>
      </div>

      <span class="menu__label">Sound</span>
      <div class="env__group" id="audio-row" role="group" aria-label="Sound">
        <button type="button" data-audio="music" data-active="true" aria-pressed="true" aria-label="Music" title="Music">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 17.5V5.2l10-2v12.3"/><circle cx="6.6" cy="17.6" r="2.4"/><circle cx="16.6" cy="15.5" r="2.4"/><line class="env__slash" x1="4.2" y1="19.8" x2="19.8" y2="4.2"/></svg>
        </button>
        <button type="button" data-audio="engine" data-active="true" aria-pressed="true" aria-label="Engine" title="Engine">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 15.5 5.3 10a2 2 0 0 1 1.9-1.4h9.6A2 2 0 0 1 18.7 10l1.8 5.5v2.6h-2.1M5.6 18.1H3.5v-2.6M3.5 15.5h17"/><circle cx="7.8" cy="18.1" r="1.7"/><circle cx="16.2" cy="18.1" r="1.7"/><line class="env__slash" x1="4.2" y1="19.8" x2="19.8" y2="4.2"/></svg>
        </button>
      </div>
      <!-- how loud: the music, and everything else (the car, the traffic, the neighbours) -->
      <label class="menu__label" for="volume-music">Music volume</label>
      <input class="menu__volume" type="range" id="volume-music" data-volume="music" min="0" max="100" step="5" value="70" aria-valuetext="70%" />
      <label class="menu__label" for="volume-sound">Sound volume</label>
      <input class="menu__volume" type="range" id="volume-sound" data-volume="sound" min="0" max="100" step="5" value="100" aria-valuetext="100%" />
      <span class="menu__label" id="tilt-label" hidden>Steering</span>
      <div class="env__group" id="tilt-row" hidden>
        <button type="button" id="tilt-toggle" class="env__auto" aria-pressed="false" title="Tilt to steer (experimental)">tilt to steer (experimental)</button>
      </div>
      <p class="menu__credit">music: yd · engine: qubodup (CC-BY, opengameart) · off-roader: Han66st (CC-BY, sketchfab) · cars: Kenney (CC0) · roads: KayKit (CC0) · houses, people: Kenney (CC0)</p>
    </div>


    <div class="welcome" id="welcome" data-open="true" tabindex="-1">
      <div class="welcome__card">
        <h1>Super Jackfruit Labs</h1>
        <p class="welcome__sub">six tools for working with agents — drive through the suite</p>
        <div
          class="welcome__bar"
          id="welcome-bar"
          role="progressbar"
          aria-label="loading the village"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <span class="welcome__fill" id="welcome-fill"></span>
        </div>
        <p class="welcome__hint" id="welcome-hint" role="status">loading the village…</p>
        <div class="welcome__actions" id="welcome-actions" hidden>
          <button type="button" id="retry-village">retry</button>
          <button type="button" id="places-fallback">browse places</button>
        </div>
        <a class="welcome__skip" href="/">or skip the drive: the suite as a page →</a>
      </div>
    </div>

    <!-- on-screen driving, for anyone without a keyboard -->
    <div class="touch" id="touch" hidden>
      <div class="touch__wheel" id="touch-steer" role="slider" tabindex="0" aria-label="Steering" aria-valuemin="-100" aria-valuemax="100" aria-valuenow="0">
        <span class="touch__knob" id="touch-knob"></span>
        <span class="touch__wheel-label">steer</span>
      </div>
      <div class="touch__pedals">
        <button class="touch__btn touch__btn--nitro" id="touch-nitro" type="button" aria-label="nitro">N</button>
        <button class="touch__btn touch__btn--brake" id="touch-brake" type="button" aria-label="brake and reverse">▼</button>
        <button class="touch__btn touch__btn--gas" id="touch-gas" type="button" aria-label="accelerate">▲</button>
      </div>
    </div>

    <!-- every desktop shortcut in one place; ? opens it, Esc or ? closes it -->
    <div class="keys" id="keys" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts" tabindex="-1" hidden>
      <h2>Keys</h2>
      <dl>
        <dt>W A S D / arrows</dt><dd>drive · steer · brake &amp; reverse</dd>
        <dt>Shift</dt><dd>nitro</dd>
        <dt>1–6</dt><dd>SuperMessage · SuperPipeline · SuperLibrary · SuperWitness · Salaam · AgentPod</dd>
        <dt>H / R</dt><dd>the lab · back to the start</dd>
        <dt>↵ / P</dt><dd>open the card's first / second link</dd>
        <dt>Space / I</dt><dd>more about it</dd>
        <dt>C</dt><dd>next car</dd>
        <dt>T</dt><dd>time of day</dd>
        <dt>M</dt><dd>mute</dd>
        <dt>N</dt><dd>minimap on or off (the map button lists every place)</dd>
        <dt>Esc</dt><dd>menu</dd>
        <dt>?</dt><dd>this list</dd>
      </dl>
    </div>

    <!-- with the cards hidden: just the place's name and how to open it -->
    <div class="chip-live" aria-live="polite">
      <a class="chip" id="place-chip" href="#" data-show="false" tabindex="-1">
        <span class="chip__key" aria-hidden="true">↵</span>
        <span id="chip-name"></span>
        <span aria-hidden="true">↗</span>
        <span class="sr-only" id="chip-how"></span>
      </a>
    </div>

    <aside class="card" id="station-card" data-open="false" aria-live="polite" aria-hidden="true" inert>
      <img id="card-logo" class="card__logo" alt="" width="48" height="48" hidden />
      <h2 id="card-name"></h2>
      <p class="card__tagline" id="card-tagline"></p>
      <p class="card__status" id="card-status"></p>
      <p class="card__desc" id="card-desc"></p>
      <button type="button" class="card__more" id="card-more" aria-expanded="false" aria-controls="card-desc">more ▾</button>
      <p class="card__tags" id="card-tags"></p>
      <div class="card__actions">
        <a id="card-github" data-key="↵" href="#" target="_blank" rel="noopener noreferrer">view source →</a>
        <a id="card-demo" data-key="P" href="#" target="_blank" rel="noopener noreferrer" hidden>live demo →</a>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .scene {
    --build: 3;
    position: fixed;
    inset: 0;
    background: #9ed4f5;
    font-family: 'Figtree Variable', system-ui, sans-serif;
  }

  #village-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }

  .hint {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    pointer-events: none;
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.6);
  }

  .hint {
    bottom: 2.2rem;
    font-size: 1.5rem;
    color: rgba(40, 50, 60, 0.85);
  }

  .env {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* each group is its own pill, so the grouping is the only label needed */
  .env__group {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    border: 1.5px solid rgba(40, 50, 60, 0.16);
    backdrop-filter: blur(4px);
  }

  .env button {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(40, 50, 60, 0.62);
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .env button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .env button:hover { color: rgba(40, 50, 60, 0.95); }

  .env button[data-active='true'] {
    background: rgba(40, 50, 60, 0.86);
    color: #f6f0e2;
  }

  .env button:focus-visible {
    outline: 2px solid #d98a1f;
    outline-offset: 2px;
  }

  /* A season is always one or the other, so the leaf is always filled — same
     "filled = current" language as the other two groups — and carries the
     season in its hue rather than inventing a second visual state. */
  /* qualified with `button` on purpose: scoping turns `.env button` into a
     higher-specificity selector than a bare class + attribute, so without the
     type selector here the transparent background wins and the leaf stays grey */
  .env button.env__leaf { color: #f6f0e2; }
  .env button.env__leaf[data-season-state='summer'] { background: rgba(58, 132, 68, 0.92); }
  .env button.env__leaf[data-season-state='autumn'] { background: rgba(190, 112, 24, 0.94); }
  .env button.env__leaf:hover { color: #fffaf0; }

  /* graphics: bars for the level, always filled because there is always a level */
  .env button.env__quality { background: rgba(40, 50, 60, 0.86); color: #f6f0e2; }
  .env button.env__quality svg rect { fill: currentColor; stroke: none; }
  .env button.env__quality[data-tier='low'] .q2,
  .env button.env__quality[data-tier='low'] .q3,
  .env button.env__quality[data-tier='medium'] .q3 { opacity: 0.3; }

  /* a struck-through icon is off; no second state to learn */
  .env button[data-active='true'] .env__slash { display: none; }
  .env__slash { stroke-width: 1.9; }

  @media (prefers-reduced-motion: reduce) {
    .env button { transition: none; }
  }

  .credit {
    position: absolute;
    right: 1.2rem;
    bottom: 0.9rem;
    left: auto;
    transform: none;
    margin: 0;
    font-size: 0.95rem;
    color: rgba(40, 50, 60, 0.45);
    pointer-events: none;
  }

  /* the project card — warm paper by day, ink after dark. Dark is the village's own
     night (the scene sets data-night), not the visitor's system theme.
     It hangs top right, just under the map, sound and menu buttons and lined up with
     their right edge, so the road ahead and the minimap at the bottom stay clear; being
     pinned at the top, a card that changes size grows downward and its title stays put. */
  .card {
    --card-bg: #f6f0e2;
    --card-fg: #2c2a26;
    --card-muted: rgba(44, 42, 38, 0.68);
    --card-link: #2c2a26;
    --card-shadow: rgba(40, 50, 60, 0.25);
    position: absolute;
    top: calc(4.8rem + env(safe-area-inset-top));
    right: calc(1.4rem + env(safe-area-inset-right));
    width: min(21.25rem, calc(100vw - 2.8rem));
    /* never down as far as the minimap (bottom right, 9.5rem tall): a long card scrolls inside */
    max-height: calc(100dvh - 4.8rem - 12rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--card-bg);
    color: var(--card-fg);
    border: 2px solid var(--accent, #d98a1f);
    border-radius: 12px;
    padding: 0.65rem 0.85rem;
    box-shadow: 0 8px 24px var(--card-shadow);
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 0.25s ease, transform 0.25s ease, background-color 0.4s ease, color 0.4s ease;
    pointer-events: none;
  }
  .scene[data-night='true'] .card {
    --card-bg: #161b2b; --card-fg: #f1ece0; --card-muted: rgba(241, 236, 224, 0.7);
    --card-link: #f1ece0; --card-shadow: rgba(0, 0, 0, 0.5);
  }

  .card[data-open='true'] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .card__logo { width: 2.1rem; height: 2.1rem; float: right; margin: 0 0 0 0.5rem; border-radius: 8px; }
  .card h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .card__tagline, .card__status {
    margin: 0.05rem 0 0;
    font-size: 0.8rem;
    color: var(--card-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card__status { letter-spacing: 0.04em; }

  /* a light ring keeps the dot visible on the dark surface too */
  .card__status::before {
    content: '';
    display: inline-block;
    width: 0.5rem; height: 0.5rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    vertical-align: 0.05em;
    background: var(--status-color, #3f9e3f);
    box-shadow: 0 0 0 1.5px var(--card-bg), 0 0 0 2.5px var(--status-color, #3f9e3f);
  }

  /* two lines are enough to say what it is; the product page has the rest */
  .card__desc {
    clear: both;
    margin: 0.35rem 0 0.45rem;
    font-size: 0.82rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__tags { display: none; }

  /* desktop key hints in front of the card's links */
  .scene:not([data-touch='true']) .card__actions a::before {
    content: attr(data-key);
    display: inline-block;
    min-width: 1.1em;
    margin-right: 0.35rem;
    padding: 0 0.25rem;
    border: 1px solid var(--card-muted);
    border-radius: 4px;
    font: 600 0.7rem 'Inconsolata Variable', monospace;
    text-align: center;
    color: var(--card-muted);
    vertical-align: 0.1em;
  }

  .keys {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    width: min(26rem, calc(100vw - 2.4rem));
    padding: 1rem 1.2rem;
    border-radius: 14px;
    background: rgba(250, 247, 240, 0.97);
