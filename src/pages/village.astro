<script>
  import { isTyping } from '../scripts/village/input';
  import { CARS, carById, type CarChoice } from '../scripts/village/cars';

  // ---------- the garage ----------
  {
    const row = document.getElementById('car-row');
    const paints = document.getElementById('paint-row');
    const paintLabel = document.getElementById('paint-label');
    const note = document.getElementById('car-note');
    let current: CarChoice = { car: CARS[0].id, paint: 0 };
    let requested = current.car;
    const pick = (next: CarChoice) => {
      requested = next.car;
      window.dispatchEvent(new CustomEvent('village:car', { detail: next }));
    };
    row?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-car]');
      if (btn && (btn.dataset.car !== current.car || requested !== current.car)) pick({ car: btn.dataset.car!, paint: 0 });
    });
    paints?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-paint]');
      if (btn) pick({ car: current.car, paint: Number(btn.dataset.paint) });
    });
    // the scene says what's being driven — at start (the remembered car) and after every pick or C
    window.addEventListener('village:car-chosen', ((e: CustomEvent<CarChoice>) => {
      current = e.detail;
      requested = current.car;
      const spec = carById(current.car);
      row?.querySelectorAll<HTMLButtonElement>('[data-car]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.car === spec.id))
      );
      if (note) note.textContent = `${spec.name}: ${spec.note}`;
      const has = spec.paints.length > 1;
      if (paints && paintLabel) {
        paints.hidden = paintLabel.hidden = !has;
        paints.replaceChildren(
          ...spec.paints.map((hex, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'menu__paint';
            b.dataset.paint = String(i);
            b.style.background = hex;
            b.setAttribute('aria-label', `Paint ${i + 1}`);
            b.setAttribute('aria-pressed', String(i === current.paint));
            return b;
          })
        );
      }
    }) as EventListener);
    window.addEventListener('village:car-loading', ((e: CustomEvent<CarChoice>) => {
      if (note) note.textContent = `loading ${carById(e.detail.car).name}…`;
    }) as EventListener);
    window.addEventListener('village:car-failed', ((e: CustomEvent<CarChoice>) => {
      if (note) note.textContent = `couldn't load ${carById(e.detail.car).name} — choose it again to retry`;
    }) as EventListener);
  }

  const canvas = document.getElementById('village-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    void import('../scripts/village-scene')
      .then(({ initVillageScene }) => initVillageScene(canvas))
      .then((started) => {
        if (!started) throw new Error('WebGL is unavailable');
      })
      .catch((error) => {
        console.error('[village] initialization failed', error);
        window.dispatchEvent(new CustomEvent('village:failed'));
      });
  }

  const STATUS_COPY: Record<string, string> = {
    released: 'released · ready to use',
    live: 'live · no tagged release yet',
    stable: 'lit & steady · open for business',
    wip: 'wet paint · mind the sparks',
    experiment: 'half-lit · enter at your own risk',
  };
  const STATUS_COLOR: Record<string, string> = {
    released: '#3f9e3f',
    live: '#3f9e3f',
    stable: '#3f9e3f',
    wip: '#d98a1f',
    experiment: '#8a5fc9',
  };

  const card = document.getElementById('station-card')!;
  const nameEl = document.getElementById('card-name')!;
  const logoEl = document.getElementById('card-logo') as HTMLImageElement;
  const taglineEl = document.getElementById('card-tagline')!;
  const statusEl = document.getElementById('card-status')!;
  const descEl = document.getElementById('card-desc')!;
  const tagsEl = document.getElementById('card-tags')!;
  const githubEl = document.getElementById('card-github') as HTMLAnchorElement;
  const demoEl = document.getElementById('card-demo') as HTMLAnchorElement;
  const setCardOpen = (open: boolean) => {
    if (!open && card.contains(document.activeElement)) document.getElementById('menu-toggle')!.focus();
    card.dataset.open = String(open);
    card.inert = !open;
    card.setAttribute('aria-hidden', String(!open));
  };
  const setLinkTarget = (link: HTMLAnchorElement, url: string) => {
    if (url.startsWith('/')) link.removeAttribute('target');
    else link.target = '_blank';
  };
  // The village has no frame around it, so it mounts the frame's Captain Jack sheet itself;
  // the sheet answers sjl-ask, as it does on every other page of the site.
  import('@superjackfruit/frontdoor/client').then(({ mountJack }) => mountJack({ product: 'lab' })).catch((e) => console.warn('[village] Captain Jack', e));
  // a card link to #captain-jack opens the frame's Captain Jack sheet instead of navigating
  for (const el of [githubEl, demoEl]) {
    el.addEventListener('click', (e) => {
      if (el.getAttribute('href') !== '#captain-jack') return;
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('sjl-ask', { detail: {} }));
    });
  }

  interface StationDetail {
    kind: 'project' | 'info';
    project?: {
      name: string;
      tagline: string;
      description: string;
      tags: string[];
      status: string;
      github: string;
      demo?: string;
      district?: string;
      next?: string;
      logo?: string;
    };
    info?: { title: string; tagline: string; logo?: string; lines: string[]; links: Array<{ label: string; url: string }> };
    accent: string;
  }

  // time of day: one active segment at a time
  const timeRow = document.getElementById('time-row')!;
  timeRow.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn || !btn.dataset.time) return;
    for (const b of timeRow.querySelectorAll('button')) {
      b.dataset.active = 'false';
      b.setAttribute('aria-pressed', 'false');
    }
    btn.dataset.active = 'true';
    btn.setAttribute('aria-pressed', 'true');
    autoTime = btn.dataset.time === 'auto';
    window.dispatchEvent(new CustomEvent('village:time', { detail: autoTime ? clockTime() : btn.dataset.time }));
  });

  // "auto" follows the visitor's own clock, and is where every visit starts
  let autoTime = true;
  const clockTime = (): string => {
    const h = new Date().getHours();
    return h >= 5 && h < 7 ? 'dawn' : h >= 7 && h < 17 ? 'day' : h >= 17 && h < 19 ? 'dusk' : 'night';
  };
  let lastClock = '';
  const followClock = () => {
    if (!autoTime) return;
    const now = clockTime();
    if (now !== lastClock) window.dispatchEvent(new CustomEvent('village:time', { detail: now }));
    lastClock = now;
  };
  window.addEventListener('village:ready', followClock);
  setInterval(followClock, 60_000);

  // ---------- the two panels: settings (the menu button) and places (the map button) ----------
  // One open at a time. A click anywhere else or Esc puts it away; while it's open, Tab and
  // Shift+Tab go round it and its button, and the arrow keys walk its controls; closing hands
  // focus back to the button that opened it.
  const menu = document.getElementById('menu')!;
  const menuBtn = document.getElementById('menu-toggle')!;
  const placesPanel = document.getElementById('places-panel')!;
  const mapBtn = document.getElementById('map-toggle')!;
  const panels = [
    { el: menu, btn: menuBtn },
    { el: placesPanel, btn: mapBtn },
  ];
  const openPanel = () => panels.find((p) => !p.el.hidden) ?? null;
  const itemsOf = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('button, a, input')].filter((x) => x.offsetParent !== null);
  /** open one panel (or none); `refocus: false` leaves focus with the page instead of the button */
  const setPanel = (el: HTMLElement | null, refocus = true) => {
    for (const p of panels) {
      const open = p.el === el;
      if (p.el.hidden === !open) continue;
      const hadFocus = p.el.contains(document.activeElement);
      p.el.hidden = !open;
      p.btn.setAttribute('aria-expanded', String(open));
      if (open) p.el.scrollTop = 0;
      else if (hadFocus) {
        if (refocus) p.btn.focus();
        else (document.activeElement as HTMLElement | null)?.blur();
      }
    }
  };
  for (const p of panels) {
    p.btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setPanel(p.el.hidden ? p.el : null);
    });
  }
  document.addEventListener('pointerdown', (e) => {
    const p = openPanel();
    if (p && !p.el.contains(e.target as Node) && !p.btn.contains(e.target as Node)) setPanel(null);
  });
  window.addEventListener('keydown', (e) => {
    if (welcome.dataset.open === 'true') return;
    const p = openPanel();
    if (e.key === 'Escape') {
      if (!keysPanel.hidden) return;
      if (p) {
        setPanel(null);
        p.btn.focus();
      } else {
        // Esc with nothing open brings up the settings, as it always has
        if (isTyping(e)) return;
        setPanel(menu);
        itemsOf(menu)[0]?.focus();
      }
      return;
    }
    if (!p) return;
    if (e.key === 'Tab') {
      const ring = [p.btn, ...itemsOf(p.el)];
      const i = ring.indexOf(document.activeElement as HTMLElement);
      e.preventDefault();
      ring[(i + (e.shiftKey ? -1 : 1) + ring.length) % ring.length]?.focus();
      return;
    }
    if (!p.el.contains(document.activeElement)) return;
    // a slider's arrows move the slider
    if ((document.activeElement as HTMLInputElement).type === 'range') return;
    const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
    if (!step) return;
    e.preventDefault();
    e.stopImmediatePropagation(); // walking a panel isn't driving
    const items = itemsOf(p.el);
    const i = items.indexOf(document.activeElement as HTMLElement);
    items[(i + step + items.length) % items.length]?.focus();
  }, { capture: true });

  // ---------- volume: two sliders, remembered per visitor ----------
  // The page keeps the numbers and tells the scene; the scene's audio only applies them to
  // sound that is already playing, so a slider moved before the first gesture starts nothing.
  {
    const DEFAULTS = { music: 70, sound: 100 } as const;
    const sliders = [...document.querySelectorAll<HTMLInputElement>('input[data-volume]')];
    const key = (bus: string) => `village:volume:${bus}`;
    const send = (input: HTMLInputElement) => {
      input.setAttribute('aria-valuetext', `${input.value}%`);
      window.dispatchEvent(new CustomEvent('village:volume', { detail: { bus: input.dataset.volume, level: Number(input.value) / 100 } }));
    };
    for (const input of sliders) {
      const bus = input.dataset.volume as keyof typeof DEFAULTS;
      let v: number = DEFAULTS[bus];
      try {
        const saved = localStorage.getItem(key(bus));
        if (saved !== null && Number.isFinite(Number(saved))) v = Math.min(100, Math.max(0, Number(saved)));
      } catch {}
      input.value = String(v);
      input.setAttribute('aria-valuetext', `${v}%`);
      input.addEventListener('input', () => {
        send(input);
        try { localStorage.setItem(key(bus), input.value); } catch {}
      });
      // the arrow keys move the slider, not the car
      input.addEventListener('keydown', (e) => e.stopPropagation());
    }
    // the scene listens once it's up
    window.addEventListener('village:ready', () => sliders.forEach(send));
  }

  // sound: the one switch that's always to hand, the same as pressing m
  const soundBtn = document.getElementById('sound-toggle')!;
  const showSound = (on: boolean) => {
    soundBtn.setAttribute('aria-pressed', String(on));
    soundBtn.setAttribute('aria-label', on ? 'Sound on. Mute' : 'Sound off. Unmute');
  };
  const requestMute = () => window.dispatchEvent(new CustomEvent('village:mute'));
  soundBtn.addEventListener('click', requestMute);
  window.addEventListener('village:mute-changed', ((e: CustomEvent<{ on: boolean }>) => showSound(e.detail.on)) as EventListener);

  // the driving legend fades once the visitor has had a few seconds with it
  const hint = document.querySelector('.hint');
  let hintTimer = 0;
  const fadeHintSoon = () => {
    if (hintTimer || !hint) return;
    hintTimer = window.setTimeout(() => hint.classList.add('faded'), 6000);
  };
  window.addEventListener('keydown', fadeHintSoon);
  window.addEventListener('pointerdown', fadeHintSoon);

  // graphics: cycles through the tiers, showing the level as filled bars
  const TIERS = ['low', 'medium', 'high'] as const;
  const qualityBtn = document.getElementById('quality-toggle')!;
  const showTier = (tier: string) => {
    qualityBtn.dataset.tier = tier;
    qualityBtn.setAttribute('aria-label', `Graphics: ${tier}. Change`);
  };
  qualityBtn.addEventListener('click', () => {
    const i = TIERS.indexOf((qualityBtn.dataset.tier ?? 'high') as (typeof TIERS)[number]);
    const next = TIERS[(i + 1) % TIERS.length];
    showTier(next);
    window.dispatchEvent(new CustomEvent('village:quality', { detail: next }));
  });
  // the scene decides the opening tier, and may drop one if the device struggles
  window.addEventListener('village:quality-changed', ((e: CustomEvent<string>) => showTier(e.detail)) as EventListener);

  // season: a single leaf that turns
  const seasonBtn = document.getElementById('season-toggle')!;
  seasonBtn.addEventListener('click', () => {
    const next = seasonBtn.dataset.seasonState === 'summer' ? 'autumn' : 'summer';
    seasonBtn.dataset.seasonState = next;
    seasonBtn.setAttribute(
      'aria-label',
      next === 'summer' ? 'Season: summer. Switch to autumn' : 'Season: autumn. Switch to summer'
    );
    window.dispatchEvent(new CustomEvent('village:season', { detail: next }));
  });

  window.addEventListener('village:station', ((e: CustomEvent<StationDetail | null>) => {
    if (!e.detail) {
      setCardOpen(false);
      return;
    }
    setExpanded(false);
    const { accent } = e.detail;
    card.style.setProperty('--accent', accent);
    if (e.detail.kind === 'info' && e.detail.info) {
      const info = e.detail.info;
      if (info.logo) {
        logoEl.src = info.logo;
        logoEl.hidden = false;
      } else logoEl.hidden = true;
      nameEl.textContent = info.title;
      taglineEl.textContent = info.tagline;
      statusEl.textContent = '';
      statusEl.setAttribute('hidden', '');
      descEl.textContent = info.lines.join(' ');
      tagsEl.textContent = '';
      githubEl.textContent = info.links[0]?.label ?? '';
      githubEl.href = info.links[0]?.url ?? '#';
      setLinkTarget(githubEl, githubEl.getAttribute('href') ?? '#');
      if (info.links[1]) {
        demoEl.textContent = info.links[1].label;
        demoEl.href = info.links[1].url;
        setLinkTarget(demoEl, info.links[1].url);
        demoEl.hidden = false;
      } else {
        demoEl.hidden = true;
      }
      setCardOpen(true);
      showMore();
      return;
    }
    const project = e.detail.project!;
    if (project.logo) {
      logoEl.src = project.logo;
      logoEl.hidden = false;
    } else logoEl.hidden = true;
    nameEl.textContent = project.name;
    taglineEl.textContent = project.tagline;
    statusEl.removeAttribute('hidden');
    statusEl.textContent = STATUS_COPY[project.status] ?? project.status;
    descEl.textContent = project.next ? `${project.description} Next stop: ${project.next}.` : project.description;
    tagsEl.textContent = project.tags.join(' · ');
    // a suite product's main link is its own website and its second is its docs;
    // anything else is an experiment, whose link is its source
    const internal = project.github.startsWith('/');
    const suite = project.district === 'agent-works';
    githubEl.textContent = internal
      ? 'open the product page →'
      : suite
        ? `visit ${new URL(project.github).host} →`
        : 'view source →';
    githubEl.href = project.github;
    setLinkTarget(githubEl, project.github);
    if (project.demo) {
      const page = project.demo.startsWith('/');
      demoEl.textContent = page ? 'about it here →' : suite ? 'read the docs →' : 'live demo →';
      demoEl.href = project.demo;
      setLinkTarget(demoEl, project.demo);
      demoEl.hidden = false;
    } else {
      demoEl.hidden = true;
    }
    card.style.setProperty('--status-color', STATUS_COLOR[project.status] ?? '#3f9e3f');
    setCardOpen(true);
    showMore();
  }) as EventListener);

  // ---------- place cards on or off, and the chip that stands in for them ----------
  const scene = document.querySelector<HTMLElement>('.scene')!;
  const cardsBtn = document.getElementById('cards-toggle')!;
  const cardsState = document.getElementById('cards-state')!;
  const chip = document.getElementById('place-chip') as HTMLAnchorElement;
  const chipName = document.getElementById('chip-name')!;
  const chipHow = document.getElementById('chip-how')!;
  let cardsOn = true;
  try { cardsOn = localStorage.getItem('village:cards') !== 'off'; } catch {}
  const showCards = (on: boolean) => {
    cardsOn = on;
    scene.dataset.cards = on ? 'on' : 'off';
    cardsBtn.setAttribute('aria-pressed', String(on));
    cardsState.textContent = on ? 'shown' : 'hidden';
    syncChip();
  };
  // the chip shows the card's place and its first link, and only while the cards are off
  function syncChip(): void {
    const show = !cardsOn && card.dataset.open === 'true' && !!githubEl.getAttribute('href');
    if (show) {
      chipName.textContent = nameEl.textContent;
      chip.href = githubEl.href;
      chip.style.setProperty('--accent', card.style.getPropertyValue('--accent'));
      chipHow.textContent = window.matchMedia('(pointer: coarse)').matches
        ? ', tap to open'
        : `, press Enter to open it${demoEl.hidden ? '' : ', or P for the second link'}`;
    }
    chip.dataset.show = String(show);
    chip.tabIndex = show ? 0 : -1;
  }
  // the chip opens what the card's first link would, Captain Jack's sheet included
  chip.addEventListener('click', (e) => {
    e.preventDefault();
    githubEl.click();
  });
  cardsBtn.addEventListener('click', () => {
    showCards(!cardsOn);
    try { localStorage.setItem('village:cards', cardsOn ? 'on' : 'off'); } catch {}
  });
  window.addEventListener('village:station', () => syncChip());
  showCards(cardsOn);

  // ---------- the places list: drive there, ticks for the ones visited ----------
  placesPanel.addEventListener('click', (e) => {
    const go = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-jump]');
    if (go) {
      window.dispatchEvent(new CustomEvent('village:jump', { detail: go.dataset.jump }));
      // focus goes back to the page, not the map button, so Enter at the house opens its link
      setPanel(null, false);
      return;
    }
    const ask = (e.target as HTMLElement).closest('a[data-ask]');
    if (ask) {
      e.preventDefault();
      setPanel(null, false);
      window.dispatchEvent(new CustomEvent('sjl-ask', { detail: {} }));
    }
  });
  window.addEventListener('village:visited', ((e: CustomEvent<{ slugs?: string[] }>) => {
    const seen = new Set(e.detail.slugs ?? []);
    for (const li of placesPanel.querySelectorAll<HTMLElement>('.menu__places li[data-slug]')) {
      li.querySelector<HTMLElement>('.place__tick')!.hidden = !seen.has(li.dataset.slug!);
    }
  }) as EventListener);

  // "more" opens the whole description (scrolling inside the card if it's long), and closes it again
  const moreBtn = document.getElementById('card-more')!;
  const setExpanded = (open: boolean) => {
    card.dataset.expanded = String(open);
    moreBtn.setAttribute('aria-expanded', String(open));
    moreBtn.textContent = open ? 'less ▴' : 'more ▾';
  };
  // only offered when there's more to read than the card already shows
  // on a small screen the card is folded to its name, so "more" is always there to open it
  const folded = window.matchMedia('(max-width: 520px), (max-height: 520px)');
  const showMore = () => {
    const overflows = !!descEl.textContent && descEl.scrollHeight > descEl.clientHeight + 1;
    moreBtn.hidden = !(folded.matches || card.dataset.expanded === 'true' || overflows);
  };
  folded.addEventListener?.('change', showMore);
  moreBtn.addEventListener('click', () => setExpanded(card.dataset.expanded !== 'true'));

  // visited counter
  const visitedChip = document.getElementById('visited-chip')!;
  const visitedCount = document.getElementById('visited-count')!;
  window.addEventListener('village:visited', ((e: CustomEvent<{ count: number; total: number }>) => {
    visitedChip.hidden = false;
    visitedCount.textContent = `${e.detail.count}/${e.detail.total}`;
    if (e.detail.count === e.detail.total) visitedChip.classList.add('done');
  }) as EventListener);

  // welcome overlay: holds a real progress bar while the village downloads,
  // then any input enters (which doubles as the audio unlock gesture)
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  const welcome = document.getElementById('welcome')!;
  const welcomeBar = document.getElementById('welcome-bar')!;
  const welcomeFill = document.getElementById('welcome-fill')!;
  const welcomeHint = document.getElementById('welcome-hint')!;
  const welcomeActions = document.getElementById('welcome-actions')!;
  let ready = false;
  let initialized = false;
  let failureReturnFocus: HTMLElement | null = null;

  const setDriveControlsEnabled = (enabled: boolean) => {
    placesPanel.querySelectorAll<HTMLButtonElement>('button[data-jump]').forEach((button) => (button.disabled = !enabled));
    document.getElementById('minimap-switch')!.toggleAttribute('disabled', !enabled);
  };
  const setBackgroundInert = (inert: boolean) => {
    document.querySelectorAll<HTMLElement>('.hud, #touch, #place-chip').forEach((el) => (el.inert = inert));
    card.inert = inert || card.dataset.open !== 'true';
  };

  const showWelcome = () => {
    setBackgroundInert(true);
    welcome.inert = false;
    welcome.removeAttribute('aria-hidden');
    welcome.dataset.open = 'true';
  };
  showWelcome();

  const markReady = () => {
    const recovering = welcome.dataset.open === 'true' && !welcomeActions.hidden;
    ready = true;
    setDriveControlsEnabled(true);
    mapBtn.hidden = false;
    welcomeActions.hidden = true;
    welcomeFill.style.width = '100%';
    welcomeBar.setAttribute('aria-valuenow', '100');
    welcomeBar.hidden = true;
    welcomeHint.textContent = isTouch ? 'tap to enter' : 'press any key or tap to enter';
    welcomeHint.dataset.ready = 'true';
    showWelcome();
    if (recovering) welcome.focus();
  };

  const showFailure = (message = 'the village could not start — retry, or browse the places instead') => {
    failureReturnFocus = welcome.dataset.open === 'false' ? document.activeElement as HTMLElement | null : null;
    ready = false;
    setDriveControlsEnabled(false);
    keysPanel.hidden = true;
    setPanel(null, false);
    mapBtn.hidden = false;
    document.getElementById('minimap')!.hidden = true;
    welcomeBar.hidden = true;
    welcomeHint.dataset.ready = 'false';
    welcomeHint.textContent = message;
    welcomeActions.hidden = false;
    showWelcome();
    document.getElementById('retry-village')!.focus();
  };

  document.getElementById('retry-village')!.addEventListener('click', () => location.reload());
  document.getElementById('places-fallback')!.addEventListener('click', () => {
    welcome.dataset.open = 'false';
    welcome.inert = true;
    welcome.setAttribute('aria-hidden', 'true');
    setBackgroundInert(false);
    setPanel(placesPanel);
    itemsOf(placesPanel)[0]?.focus();
  });
  window.addEventListener('village:failed', () => showFailure());
  if (canvas instanceof HTMLCanvasElement) {
    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      showFailure('graphics paused — restore the context or retry');
    });
    canvas.addEventListener('webglcontextrestored', () => {
      if (!initialized) return;
      markReady();
      window.dispatchEvent(new CustomEvent('village:minimap-restore'));
    });
  }

  window.addEventListener('village:loading', ((e: CustomEvent<number>) => {
    const pct = Math.round(e.detail * 100);
    welcomeFill.style.width = `${pct}%`;
    welcomeBar.setAttribute('aria-valuenow', String(pct));
  }) as EventListener);

  // ---------- the minimap: shown once the village is up, unless it was put away last time ----------
  // its switch lives in the map button's panel; N flips it directly
  {
    const map = document.getElementById('minimap')!;
    const sw = document.getElementById('minimap-switch')!;
    const state = document.getElementById('minimap-state')!;
    const KEY = 'village:minimap';
    const reflect = (on: boolean) => {
      sw.setAttribute('aria-pressed', String(on));
      state.textContent = on ? 'shown' : 'hidden';
    };
    const show = (on: boolean) => {
      map.hidden = !on;
      reflect(on);
      try { localStorage.setItem(KEY, on ? 'on' : 'off'); } catch {}
    };
    const restore = () => {
      let on = true;
      try { on = localStorage.getItem(KEY) !== 'off'; } catch {}
      map.hidden = !on;
      reflect(on);
    };
    window.addEventListener('village:ready', restore);
    window.addEventListener('village:minimap-restore', restore);
    sw.addEventListener('click', () => show(map.hidden));
    window.addEventListener('keydown', (e) => {
      if (!ready || isTyping(e) || e.ctrlKey || e.metaKey || e.altKey || e.key.toLowerCase() !== 'n' || mapBtn.hidden) return;
      show(map.hidden);
    });
  }

  window.addEventListener('village:ready', () => {
    initialized = true;
    markReady();
  });

  function enterVillage(e: Event) {
    if (!ready || welcome.dataset.open === 'false') return;
    window.dispatchEvent(new CustomEvent('village:gesture'));
    e.preventDefault();
    e.stopImmediatePropagation();
    welcome.dataset.open = 'false';
    welcome.inert = true;
    welcome.setAttribute('aria-hidden', 'true');
    setBackgroundInert(false);
    const returnFocus = failureReturnFocus;
    failureReturnFocus = null;
    if (returnFocus) {
      const target = returnFocus.isConnected && returnFocus.getClientRects().length > 0 ? returnFocus : menuBtn;
      target.focus();
    }
  }
  window.addEventListener('keydown', enterVillage, true);
  welcome.addEventListener('pointerdown', enterVillage);

  // ---------- on-screen driving ----------
  if (isTouch) {
    document.querySelector('.scene')?.setAttribute('data-touch', 'true');
    const panel = document.getElementById('touch')!;
    panel.hidden = false;

    const touchState = { steer: 0, throttle: 0, nitro: false };
    // the wheel wins while a thumb is on it; otherwise a tilted phone steers
    let tiltSteer = 0;
    const push = () =>
      window.dispatchEvent(
        new CustomEvent('village:touch', {
          detail: { ...touchState, steer: steerPointer === null && tiltOn ? tiltSteer : touchState.steer },
        })
      );

    const wheel = document.getElementById('touch-steer')!;
    const knob = document.getElementById('touch-knob')!;
    let steerPointer: number | null = null;
    const setSteer = (value: number) => {
      touchState.steer = Math.max(-1, Math.min(1, value));
      knob.style.transform = `translateX(${touchState.steer * 145}%)`;
      wheel.setAttribute('aria-valuenow', String(Math.round(touchState.steer * 100)));
      push();
    };
    // 2.4 rather than 2.0 so full lock arrives before the thumb runs out of pad
    const readSteer = (e: PointerEvent) => {
      const r = wheel.getBoundingClientRect();
      setSteer(((e.clientX - r.left) / r.width - 0.5) * 2.4);
    };
    wheel.addEventListener('pointerdown', (e) => {
      steerPointer = e.pointerId;
      wheel.setPointerCapture(e.pointerId);
      readSteer(e);
    });
    wheel.addEventListener('pointermove', (e) => {
      if (e.pointerId === steerPointer) readSteer(e);
    });
    for (const type of ['pointerup', 'pointercancel'] as const) {
      wheel.addEventListener(type, (e) => {
        if (e.pointerId !== steerPointer) return;
        steerPointer = null;
        setSteer(0);
      });
    }
    wheel.addEventListener('keydown', (e) => {
      const step = { ArrowLeft: -0.1, ArrowDown: -0.1, ArrowRight: 0.1, ArrowUp: 0.1 }[e.key];
      if (step === undefined && !['Home', 'End', '0'].includes(e.key)) return;
      e.preventDefault();
      e.stopPropagation();
      setSteer(e.key === 'Home' ? -1 : e.key === 'End' ? 1 : e.key === '0' ? 0 : touchState.steer + step!);
    });

    const hold = (el: HTMLElement, on: () => void, off: () => void) => {
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        el.setPointerCapture(e.pointerId);
        el.dataset.active = 'true';
        on();
        push();
      });
      for (const type of ['pointerup', 'pointercancel'] as const) {
        el.addEventListener(type, () => {
          el.dataset.active = 'false';
          off();
          push();
        });
      }
    };
    hold(document.getElementById('touch-gas')!, () => (touchState.throttle = 1), () => (touchState.throttle = 0));
    hold(document.getElementById('touch-brake')!, () => (touchState.throttle = -1), () => (touchState.throttle = 0));
    // ---------- tilt to steer (opt-in, remembered) ----------
    let tiltOn = false;
    const Orientation = (window as any).DeviceOrientationEvent as
      | (typeof DeviceOrientationEvent & { requestPermission?: () => Promise<string> })
      | undefined;
    // desktop browsers expose the event too; tilt is for devices held in the hand
    if (Orientation && matchMedia('(pointer: coarse)').matches) {
      const tiltBtn = document.getElementById('tilt-toggle')!;
      document.getElementById('tilt-row')!.hidden = false;
      document.getElementById('tilt-label')!.hidden = false;
      const store = (on: boolean) => {
        try { localStorage.setItem('village:tilt', on ? '1' : '0'); } catch { /* private mode */ }
      };
      const setTilt = (on: boolean) => {
        tiltOn = on;
        tiltBtn.setAttribute('aria-pressed', String(on));
        tiltBtn.dataset.active = String(on);
        if (!on) tiltSteer = 0;
        panel.dataset.tilt = String(on);
        push();
      };
      // NB: iOS Safari only delivers orientation events over HTTPS, so this path
      // is unverified on a real iPhone until it's deployed (localhost http won't fire)
      // roll, whichever way up the phone is held: gamma in portrait, beta on its side
      let smooth = 0;
      window.addEventListener('deviceorientation', (e) => {
        if (!tiltOn) return;
        const angle = screen.orientation?.angle ?? (window as any).orientation ?? 0;
        const roll = angle === 90 ? (e.beta ?? 0) : angle === -90 || angle === 270 ? -(e.beta ?? 0) : (e.gamma ?? 0);
        // ~4° of dead zone so a resting hand drives straight; full lock by ~25°
        const mag = Math.max(0, Math.min(1, (Math.abs(roll) - 4) / 21));
        smooth += (Math.sign(roll) * mag - smooth) * 0.3;
        tiltSteer = Math.abs(smooth) < 0.01 ? 0 : smooth;
        push();
      });
      tiltBtn.addEventListener('click', async () => {
        if (tiltOn) return (setTilt(false), store(false));
        // iOS asks once, and only from inside a tap
        if (typeof Orientation.requestPermission === 'function') {
          try {
            if ((await Orientation.requestPermission()) !== 'granted') return;
          } catch {
            return;
          }
        }
        setTilt(true);
        store(true);
      });
      let saved = false;
      try { saved = localStorage.getItem('village:tilt') === '1'; } catch { /* private mode */ }
      // iOS forgets the grant between visits, so a remembered "on" there waits for the next tap
      if (saved && typeof Orientation.requestPermission !== 'function') setTilt(true);
    }

    hold(document.getElementById('touch-nitro')!, () => (touchState.nitro = true), () => (touchState.nitro = false));
  }

  // ---------- desktop shortcuts: the card, the clock and the key list ----------
  const keysPanel = document.getElementById('keys')!;
  if (!window.matchMedia('(pointer: coarse)').matches) {
    const TIMES = ['auto', 'dawn', 'day', 'dusk', 'night'];
    let keysReturnFocus: HTMLElement | null = null;
    const closeKeys = () => {
      keysPanel.hidden = true;
      if (keysReturnFocus?.isConnected) keysReturnFocus.focus();
      keysReturnFocus = null;
    };
    window.addEventListener('keydown', (e) => {
      if (welcome.dataset.open === 'true' || isTyping(e) || e.ctrlKey || e.metaKey || e.altKey) return;
      if (!keysPanel.hidden && e.key === 'Tab') {
        e.preventDefault();
        keysPanel.focus();
        return;
      }
      if (e.key === '?' || (e.key === 'Escape' && !keysPanel.hidden)) {
        e.preventDefault();
        if (!keysPanel.hidden) closeKeys();
        else {
          setPanel(null);
          keysReturnFocus = document.activeElement as HTMLElement | null;
          keysPanel.hidden = false;
          keysPanel.focus();
        }
        return;
      }
      if (!keysPanel.hidden) return;
      const k = e.key.toLowerCase();
      if (k === 't') {
        const now = timeRow.querySelector<HTMLElement>('[data-active="true"]')?.dataset.time ?? 'auto';
        timeRow.querySelector<HTMLElement>(`[data-time="${TIMES[(TIMES.indexOf(now) + 1) % TIMES.length]}"]`)?.click();
        return;
      }
      // a focused button or link already answers Enter and Space itself
      if (welcome.dataset.open !== 'false' || card.dataset.open !== 'true' || (document.activeElement as HTMLElement)?.closest?.('button, a')) return;
      if (e.key === 'Enter') githubEl.click();
      else if (k === 'p' && !demoEl.hidden) demoEl.click();
      else if ((k === ' ' || k === 'i') && !moreBtn.hidden) setExpanded(card.dataset.expanded !== 'true');
    });
  }

  // separate audio toggles
  document.getElementById('audio-row')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn || !btn.dataset.audio) return;
    const on = btn.dataset.active !== 'true';
    btn.dataset.active = String(on);
    btn.setAttribute('aria-pressed', String(on));
    window.dispatchEvent(new CustomEvent('village:audio', { detail: { channel: btn.dataset.audio, on } }));
  });
</script>
