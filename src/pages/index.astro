---
import Site from '../layouts/Site.astro';
import { suite, coming, CONTACT, accentAttrs } from '../data/suite';

/** the cards follow the village: Main Street first, then the Agent Quarter */
const ORDER = ['supermessage', 'superpipeline', 'superlibrary', 'superwitness', 'salaam', 'agentpod'];
const QUARTER = new Set(['salaam', 'agentpod']);
const cards = ORDER.map((slug) => suite.find((p) => p.slug === slug)!);
const docs = (p: (typeof suite)[number]) => p.links.find((l) => l.label === 'Docs')!.href;
---

<Site title="Super Jackfruit Labs — agent-native tools">
  <section class="hero">
    <div class="hero__text">
      <h1>Six tools for working with agents.</h1>
      <p>Talk, plan, do, run, remember, prove. Each one below; or take the car and meet them in the village.</p>
    </div>
    <a class="window" href="/village">
      <img
        src="/village-preview.webp"
        width="1600"
        height="950"
        loading="eager"
        alt="The village: a road lined with the suite's houses and signs"
      />
      <span class="window__label">Drive through the village →</span>
    </a>
  </section>

  <section id="products" aria-label="The suite">
    <ul class="cards">
      {cards.map((p) => (
        <li class="card" {...accentAttrs(p)}>
          <img class="logo" src={`/brand/${p.slug}.svg`} alt="" width="44" height="44" />
          <div class="card__body">
            <div class="card__title">
              <a class="name" href={`/products/${p.slug}`}>{p.name}</a>
              <span class="street">{QUARTER.has(p.slug) ? 'AGENT QUARTER' : 'MAIN ST'}</span>
            </div>
            <p class="headline">{p.headline}</p>
            <div class="card__actions">
              <a class="go" href={p.site}>{new URL(p.site).host} →</a>
              <a class="more" href={docs(p)}>Docs</a>
              <span class="status">{p.status}{p.version ? ` · ${p.version}` : ''}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="coming">
      <span class="kicker">Coming</span>
      {coming.map((c) => <span><strong>{c.name}</strong> — {c.blurb}</span>)}
      <a class="team" href={`mailto:${CONTACT}`}>Run it with your team →</a>
    </div>
  </section>
</Site>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
    padding: 3rem 0 0;
  }
  .hero__text { grid-column: span 5; }
  h1 {
    font-family: var(--vk-font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.03;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .hero__text p { font-size: 1.2rem; line-height: 1.55; color: var(--vk-color-muted); margin: 1.25rem 0 0; }
  .window {
    grid-column: span 7;
    position: relative;
    display: block;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--vk-color-line);
    text-decoration: none;
  }
  .window img { display: block; width: 100%; height: 380px; object-fit: cover; transition: transform .4s ease; }
  .window:hover img { transform: scale(1.02); }
  .window__label {
    position: absolute;
    left: 20px;
    bottom: 20px;
    background: rgba(15, 14, 20, 0.82);
    color: #fff;
    padding: 12px 18px;
    border-radius: 12px;
    font-weight: 600;
  }
  .window:focus-visible { outline: 3px solid var(--vk-color-accent); outline-offset: 3px; }

  #products { padding-top: 3.5rem; scroll-margin-top: 1rem; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--vk-color-surface);
    border: 1px solid var(--vk-color-line);
    border-radius: 18px;
    /* keeps the frame's reveal (opacity, transform, its stagger delay) alongside the hover */
    transition: opacity .6s cubic-bezier(.2, .8, .2, 1) var(--vk-rv-d, 0ms), transform .4s cubic-bezier(.2, .8, .2, 1) var(--vk-rv-d, 0ms), border-color .25s ease, box-shadow .25s ease;
  }
  /* the cards answer the pointer as the product pages' do: a small lift, the logo turns */
  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--vk-color-accent) 45%, var(--vk-color-line));
    box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--vk-color-accent) 60%, transparent);
  }
  .logo { width: 44px; height: 44px; flex: none; transition: transform .45s cubic-bezier(.3, 1.6, .5, 1); }
  .card:hover .logo { transform: rotate(-8deg) scale(1.08); }
  .card__body { display: flex; flex-direction: column; gap: .5rem; min-width: 0; }
  .card__title { display: flex; flex-wrap: wrap; gap: .25rem .6rem; align-items: baseline; }
  .name { font-family: var(--vk-font-display); font-weight: 700; font-size: 1.25rem; text-decoration: none; }
  .name:hover { color: var(--vk-color-accent-text); }
  .street { font-family: var(--vk-font-mono); font-size: .66rem; letter-spacing: .1em; color: var(--vk-color-muted); }
  .headline { margin: 0; line-height: 1.45; flex: 1; }
  .card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; margin-top: .25rem; }
  .go {
    background: var(--vk-color-accent);
    color: var(--vk-color-accent-fg);
    font-weight: 600;
    font-size: .85rem;
    padding: .45rem .75rem;
    border-radius: 9px;
    text-decoration: none;
    white-space: nowrap;
  }
  .more { font-size: .85rem; color: var(--vk-color-muted); }
  .status { font-size: .78rem; color: var(--vk-color-muted); }

  .coming {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.5rem;
    align-items: baseline;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--vk-color-line);
    border-radius: 18px;
    color: var(--vk-color-muted);
  }
  .team { margin-left: auto; font-weight: 600; color: var(--vk-color-text); }

  @media (max-width: 960px) {
    .hero__text, .window { grid-column: 1 / -1; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 2rem; gap: 1.5rem; }
    .window img { height: 220px; }
    .window__label { left: 12px; bottom: 12px; padding: 10px 14px; }
    .cards { grid-template-columns: 1fr; }
    .team { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .window img, .card, .logo { transition: none; } .card:hover, .card:hover .logo { transform: none; } }
</style>
